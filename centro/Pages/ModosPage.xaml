<?xml version="1.0" encoding="utf-8"?>
<c:PaginaBase
    x:Class="CentroAether.Pages.ModosPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CentroAether.Controles">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <c:Pila Padding="36,30,36,36" Spacing="12" MaxWidth="1000">

            <c:Encabezado Glyph="&#xE7FC;" Titulo="Modos" Subtitulo="Elige cómo se comporta tu equipo según lo que estés haciendo.">
                <Button Click="VistaPreviaOverlay_Click">
                    <c:Pila Orientation="Horizontal" Spacing="8">
                        <c:FontIcon Glyph="&#xE7B3;" FontSize="14" />
                        <TextBlock Text="Ver animación" />
                    </c:Pila>
                </Button>
            </c:Encabezado>

            <c:InfoBar x:Name="Estado" IsOpen="False" IsClosable="True" Severity="Informational" />

            <UniformGrid x:Name="GridModos" Columns="3" Margin="0,4,-12,-12" />

            <TextBlock Text="Cómo funciona" Style="{StaticResource SeccionTextBlockStyle}" />
            <c:FilaAjuste Glyph="&#xE945;" Titulo="Cambio siempre a mano"
                          Descripcion="Trabajo y Gaming solo cambian cuando tú lo eliges, desde aquí, la bandeja o los atajos Ctrl+Alt+T / Ctrl+Alt+G / Ctrl+Alt+B." />
            <c:FilaAjuste Glyph="&#xE83E;" Titulo="Batería automática"
                          Descripcion="El Modo Batería se activa solo al llegar al nivel que elijas (sección Batería) y vuelve al modo anterior al conectar el cargador." />
        </c:Pila>
    </ScrollViewer>
</c:PaginaBase>
