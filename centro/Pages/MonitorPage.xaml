<?xml version="1.0" encoding="utf-8"?>
<c:PaginaBase
    x:Class="CentroAether.Pages.MonitorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CentroAether.Controles">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <c:Pila Padding="32,28,32,28" Spacing="20" MaxWidth="720" HorizontalAlignment="Left">

            <Grid>
                <c:Pila Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Monitor" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="Uso del equipo en tiempo real"
                               Foreground="{StaticResource TextFillColorSecondaryBrush}" />
                </c:Pila>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="{StaticResource AccentFillColorDefaultBrush}"
                        CornerRadius="14" Padding="14,6,14,6">
                    <TextBlock x:Name="TxtModo" Text="Modo activo: …"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
            </Grid>

            <!-- CPU -->
            <Border Background="{StaticResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{StaticResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20,16,20,16">
                <c:Pila Spacing="10">
                    <Grid>
                        <c:Pila Orientation="Horizontal" Spacing="10">
                            <c:FontIcon Glyph="&#xE950;" FontSize="18"
                                      Foreground="{StaticResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Procesador (CPU)" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </c:Pila>
                        <TextBlock x:Name="TxtCpu" Text="—" HorizontalAlignment="Right"
                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                    </Grid>
                    <ProgressBar x:Name="BarraCpu" Minimum="0" Maximum="100" Value="0" />
                    <TextBlock x:Name="TxtCpuDetalle" Text=""
                               FontSize="12" Foreground="{StaticResource TextFillColorTertiaryBrush}" />
                </c:Pila>
            </Border>

            <!-- RAM -->
            <Border Background="{StaticResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{StaticResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20,16,20,16">
                <c:Pila Spacing="10">
                    <Grid>
                        <c:Pila Orientation="Horizontal" Spacing="10">
                            <c:FontIcon Glyph="&#xEEA0;" FontSize="18"
                                      Foreground="{StaticResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Memoria (RAM)" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </c:Pila>
                        <TextBlock x:Name="TxtRam" Text="—" HorizontalAlignment="Right"
                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                    </Grid>
                    <ProgressBar x:Name="BarraRam" Minimum="0" Maximum="100" Value="0" />
                    <TextBlock x:Name="TxtRamDetalle" Text=""
                               FontSize="12" Foreground="{StaticResource TextFillColorTertiaryBrush}" />
                </c:Pila>
            </Border>

            <!-- Resumen -->
            <Border Background="{StaticResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{StaticResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20,16,20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <c:Pila Grid.Column="0" Spacing="2">
                        <TextBlock Text="Encendido desde hace" FontSize="12"
                                   Foreground="{StaticResource TextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="TxtUptime" Text="—" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </c:Pila>
                    <c:Pila Grid.Column="1" Spacing="2" Margin="24,0,0,0">
                        <TextBlock Text="Procesos activos" FontSize="12"
                                   Foreground="{StaticResource TextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="TxtProcesos" Text="—" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </c:Pila>
                </Grid>
            </Border>

            <TextBlock Text="La temperatura y el uso de GPU se añadirán en una próxima fase."
                       FontSize="12" Foreground="{StaticResource TextFillColorTertiaryBrush}" />
        </c:Pila>
    </ScrollViewer>
</c:PaginaBase>
