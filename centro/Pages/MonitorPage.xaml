<?xml version="1.0" encoding="utf-8"?>
<c:PaginaBase
    x:Class="CentroAether.Pages.MonitorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CentroAether.Controles">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <c:Pila Padding="36,30,36,36" Spacing="12" MaxWidth="1000">

            <c:Encabezado Glyph="&#xE9D9;" ColorIcono="#7A5AF8" Titulo="Monitor" Subtitulo="Uso del equipo en tiempo real.">
                <Border CornerRadius="14" Padding="14,6" Background="#1B3A63" BorderBrush="#2F8CFF" BorderThickness="1">
                    <TextBlock x:Name="TxtModo" Text="Modo: …" FontWeight="SemiBold" />
                </Border>
            </c:Encabezado>

            <UniformGrid Columns="2" Margin="0,4,-12,-12">
                <!-- CPU -->
                <Border Style="{StaticResource TarjetaStyle}" Margin="0,0,12,12">
                    <c:Pila Spacing="12">
                        <Grid>
                            <c:Pila Orientation="Horizontal" Spacing="10">
                                <c:FontIcon Glyph="&#xE950;" FontSize="18" Foreground="{StaticResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="Procesador" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                            </c:Pila>
                        </Grid>
                        <TextBlock x:Name="TxtCpu" Text="—" FontSize="40" FontWeight="SemiBold" />
                        <ProgressBar x:Name="BarraCpu" Minimum="0" Maximum="100" Value="0" Height="8" />
                        <TextBlock x:Name="TxtCpuDetalle" Text="" FontSize="12.5" Foreground="{StaticResource TextFillColorSecondaryBrush}" />
                    </c:Pila>
                </Border>

                <!-- RAM -->
                <Border Style="{StaticResource TarjetaStyle}" Margin="0,0,12,12">
                    <c:Pila Spacing="12">
                        <c:Pila Orientation="Horizontal" Spacing="10">
                            <c:FontIcon Glyph="&#xEEA0;" FontSize="18" Foreground="{StaticResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Memoria RAM" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        </c:Pila>
                        <TextBlock x:Name="TxtRam" Text="—" FontSize="40" FontWeight="SemiBold" />
                        <ProgressBar x:Name="BarraRam" Minimum="0" Maximum="100" Value="0" Height="8" Foreground="#7A5AF8" />
                        <TextBlock x:Name="TxtRamDetalle" Text="" FontSize="12.5" Foreground="{StaticResource TextFillColorSecondaryBrush}" />
                    </c:Pila>
                </Border>

                <!-- Encendido -->
                <c:FilaAjuste Glyph="&#xE823;" Titulo="Encendido desde hace" Margin="0,0,12,12">
                    <TextBlock x:Name="TxtUptime" Text="—" FontSize="16" FontWeight="SemiBold" />
                </c:FilaAjuste>

                <!-- Procesos -->
                <c:FilaAjuste Glyph="&#xE9F9;" Titulo="Procesos activos" Margin="0,0,12,12">
                    <TextBlock x:Name="TxtProcesos" Text="—" FontSize="16" FontWeight="SemiBold" />
                </c:FilaAjuste>
            </UniformGrid>

            <TextBlock Text="Gráfica, disco, red y temperatura" Style="{StaticResource SeccionTextBlockStyle}" />
            <c:Estadisticas x:Name="Detalle" />

            <TextBlock Text="Lo que más consume ahora" Style="{StaticResource SeccionTextBlockStyle}" />
            <Border Style="{StaticResource TarjetaStyle}" Padding="18,12">
                <StackPanel x:Name="PanelTop" />
            </Border>
        </c:Pila>
    </ScrollViewer>
</c:PaginaBase>
