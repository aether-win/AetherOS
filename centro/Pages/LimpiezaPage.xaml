<?xml version="1.0" encoding="utf-8"?>
<c:PaginaBase
    x:Class="CentroAether.Pages.LimpiezaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CentroAether.Controles">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <c:Pila Padding="36,30,36,36" Spacing="8" MaxWidth="1000">
            <c:Encabezado Glyph="&#xE75C;" ColorIcono="#3FBF7F" Titulo="Smart Boost" Subtitulo="Libera espacio y recursos sin tocar tus archivos." />
            <c:InfoBar x:Name="Estado" IsOpen="False" IsClosable="True" Severity="Informational" Margin="0,0,0,4" />

            <TextBlock Text="Limpieza" Style="{StaticResource SeccionTextBlockStyle}" />
            <c:FilaAjuste Glyph="&#xE74D;" Titulo="Limpiar temporales y papelera"
                          Descripcion="Borra archivos temporales y vacía la papelera. Nunca toca Descargas, Escritorio ni Documentos.">
                <Button x:Name="BtnLimpiar" Content="Limpiar ahora" Style="{StaticResource AccentButtonStyle}" Click="Limpiar_Click" />
            </c:FilaAjuste>
            <c:FilaAjuste Glyph="&#xEDA2;" Titulo="Almacenamiento de Windows"
                          Descripcion="Mira qué ocupa espacio en tu disco y usa el Sensor de almacenamiento.">
                <Button x:Name="BtnAlmacen" Content="Abrir" Click="Almacen_Click" />
            </c:FilaAjuste>
            <c:FilaAjuste Glyph="&#xE7B8;" Titulo="Limpieza de Windows"
                          Descripcion="Temporales del sistema, descargas viejas de Windows Update y caché de Optimización de distribución. No toca tus archivos.">
                <Button x:Name="BtnLimpiezaWindows" Content="Limpiar" Click="LimpiezaWindows_Click" />
            </c:FilaAjuste>
            <c:FilaAjuste Glyph="&#xEDA2;" Titulo="¿Qué ocupa espacio?"
                          Descripcion="Mide tus carpetas principales, Windows Update y los juegos de Steam.">
                <c:FilaAjuste.Debajo>
                    <TextBlock x:Name="TxtEspacio" FontFamily="Cascadia Mono, Consolas" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap" />
                </c:FilaAjuste.Debajo>
                <Button x:Name="BtnQueOcupa" Content="Medir" Click="QueOcupa_Click" />
            </c:FilaAjuste>
        </c:Pila>
    </ScrollViewer>
</c:PaginaBase>
