<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CentroAether.Pages.SoftwarePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="32,28,32,28" Spacing="16" MaxWidth="820" HorizontalAlignment="Left">

            <StackPanel Spacing="2">
                <TextBlock Text="Software" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Instala aplicaciones confiables con un clic (vía winget). Nada de software pirata."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <Button x:Name="BtnActualizarTodo" Click="ActualizarTodo_Click" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE895;" FontSize="16" />
                    <TextBlock Text="Actualizar todo lo instalado" />
                </StackPanel>
            </Button>

            <InfoBar x:Name="Estado" IsOpen="False" IsClosable="True" Severity="Informational" />

            <StackPanel x:Name="Contenedor" Spacing="10" />
        </StackPanel>
    </ScrollViewer>
</Page>
