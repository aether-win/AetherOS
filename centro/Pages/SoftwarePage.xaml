<?xml version="1.0" encoding="utf-8"?>
<c:PaginaBase
    x:Class="CentroAether.Pages.SoftwarePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CentroAether.Controles">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <c:Pila Padding="36,30,36,36" Spacing="8" MaxWidth="1000">
            <c:Encabezado Glyph="&#xE719;" ColorIcono="#4FC3F7" Titulo="Software" Subtitulo="Apps confiables en un clic (vía winget). Nada de software pirata.">
                <Button x:Name="BtnActualizarTodo" Click="ActualizarTodo_Click">
                    <c:Pila Orientation="Horizontal" Spacing="8">
                        <c:FontIcon Glyph="&#xE895;" FontSize="14" />
                        <TextBlock Text="Actualizar todo" />
                    </c:Pila>
                </Button>
            </c:Encabezado>
            <c:InfoBar x:Name="Estado" IsOpen="False" IsClosable="True" Severity="Informational" Margin="0,0,0,4" />

            <c:Pila x:Name="Contenedor" Spacing="8" />
        </c:Pila>
    </ScrollViewer>
</c:PaginaBase>
