<?xml version="1.0" encoding="utf-8"?>
<c:PaginaBase
    x:Class="CentroAether.Pages.SoftwarePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CentroAether.Controles">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <c:Pila Padding="32,28,32,28" Spacing="16" MaxWidth="820" HorizontalAlignment="Left">

            <c:Pila Spacing="2">
                <TextBlock Text="Software" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Instala aplicaciones confiables con un clic (vía winget). Nada de software pirata."
                           Foreground="{StaticResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </c:Pila>

            <Button x:Name="BtnActualizarTodo" Click="ActualizarTodo_Click" HorizontalAlignment="Left">
                <c:Pila Orientation="Horizontal" Spacing="8">
                    <c:FontIcon Glyph="&#xE895;" FontSize="16" />
                    <TextBlock Text="Actualizar todo lo instalado" />
                </c:Pila>
            </Button>

            <c:InfoBar x:Name="Estado" IsOpen="False" IsClosable="True" Severity="Informational" />

            <c:Pila x:Name="Contenedor" Spacing="10" />
        </c:Pila>
    </ScrollViewer>
</c:PaginaBase>
