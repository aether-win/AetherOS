<?xml version="1.0" encoding="utf-8"?>
<c:PaginaBase
    x:Class="CentroAether.Pages.SaludPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CentroAether.Controles">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,24,32,24">
        <c:Pila Spacing="18" MaxWidth="900" HorizontalAlignment="Left">
            <c:Pila Orientation="Horizontal" Spacing="12">
                <c:FontIcon Glyph="&#xE95E;" FontSize="28" />
                <c:Pila>
                    <TextBlock Text="Salud" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="Estado de la bateria de tu laptop."
                               Foreground="{StaticResource TextFillColorSecondaryBrush}" />
                </c:Pila>
            </c:Pila>

            <Border Background="{StaticResource LayerFillColorDefaultBrush}"
                    BorderBrush="{StaticResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <c:Pila Spacing="10">
                    <TextBlock x:Name="TxtSalud" FontSize="30" FontWeight="SemiBold" Text="..." />
                    <TextBlock x:Name="TxtDetalle" Foreground="{StaticResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" Text="" />
                    <ProgressBar x:Name="BarSalud" Minimum="0" Maximum="100" Value="0" Height="8" />
                </c:Pila>
            </Border>
        </c:Pila>
    </ScrollViewer>
</c:PaginaBase>
