<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CentroAether.Pages.SaludPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="32,24,32,24">
        <StackPanel Spacing="18" MaxWidth="900" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon Glyph="&#xE95E;" FontSize="28" />
                <StackPanel>
                    <TextBlock Text="Salud" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="Estado de la bateria de tu laptop."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="TxtSalud" FontSize="30" FontWeight="SemiBold" Text="..." />
                    <TextBlock x:Name="TxtDetalle" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" Text="" />
                    <ProgressBar x:Name="BarSalud" Minimum="0" Maximum="100" Value="0" Height="8" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
