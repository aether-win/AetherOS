<?xml version="1.0" encoding="utf-8"?>
<c:PaginaBase
    x:Class="CentroAether.Pages.WindPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CentroAether.Controles">

    <Grid Margin="32,24,32,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <c:Pila Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,14">
            <c:FontIcon Glyph="&#xE790;" FontSize="28" />
            <c:Pila>
                <TextBlock Text="Wind-Aether" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Activa o desactiva cada mod visual. Empiezan todos apagados."
                           Foreground="{StaticResource TextFillColorSecondaryBrush}" />
            </c:Pila>
        </c:Pila>

        <c:InfoBar x:Name="AvisoWindhawk" Grid.Row="1" IsOpen="False" IsClosable="False" Margin="0,0,0,14"
                   Severity="Warning"
                   Message="Windhawk todavia no esta instalado. Wind-Aether usa Windhawk para aplicar los mods.">
            <c:InfoBar.ActionButton>
                <Button Content="Instalar Windhawk" Click="InstalarWindhawk_Click" />
            </c:InfoBar.ActionButton>
        </c:InfoBar>

        <Border Grid.Row="2" Background="{StaticResource LayerFillColorDefaultBrush}"
                BorderBrush="{StaticResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="6">
                <ItemsControl x:Name="ListaMods">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Nombre}" VerticalAlignment="Center"
                                           TextWrapping="Wrap" Margin="0,0,12,0" />
                                <c:ToggleSwitch Grid.Column="1" IsOn="{Binding Activo, Mode=TwoWay}"
                                                Toggled="Mod_Toggled" Tag="{Binding Id}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <c:InfoBar x:Name="Estado" Grid.Row="3" Margin="0,14,0,0" IsOpen="False" IsClosable="True" Severity="Informational" />
    </Grid>
</c:PaginaBase>
