<?xml version="1.0" encoding="utf-8"?>
<c:PaginaBase
    x:Class="CentroAether.Pages.WindPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CentroAether.Controles">

    <Grid Margin="36,30,36,20" MaxWidth="1000">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <c:Encabezado Grid.Row="0" Glyph="&#xE790;" ColorIcono="#E879F9" Titulo="Wind-Aether"
                      Subtitulo="Activa o desactiva cada mod visual de Windhawk. Empiezan todos apagados." Margin="0,0,0,14">
            <Border CornerRadius="14" Padding="14,6" Background="#3A1F4A" BorderBrush="#E879F9" BorderThickness="1">
                <TextBlock x:Name="TxtConteo" Text="…" FontWeight="SemiBold" />
            </Border>
        </c:Encabezado>

        <c:InfoBar x:Name="AvisoWindhawk" Grid.Row="1" IsOpen="False" IsClosable="False" Margin="0,0,0,14"
                   Severity="Warning"
                   Message="Windhawk todavia no esta instalado. Wind-Aether usa Windhawk para aplicar los mods.">
            <c:InfoBar.ActionButton>
                <Button Content="Instalar Windhawk" Click="InstalarWindhawk_Click" />
            </c:InfoBar.ActionButton>
        </c:InfoBar>

        <Border Grid.Row="2" Background="#0F2036" BorderBrush="#1C3756" BorderThickness="1" CornerRadius="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="4,6">
                <ItemsControl x:Name="ListaMods">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#16304F" BorderThickness="0,0,0,1" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="9" Background="#16304F" Margin="0,0,14,0">
                                    <c:FontIcon Glyph="&#xE790;" FontSize="15" Foreground="#E879F9" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Nombre}" VerticalAlignment="Center"
                                           TextWrapping="Wrap" Margin="0,0,12,0" FontSize="14" />
                                <c:ToggleSwitch Grid.Column="2" IsOn="{Binding Activo, Mode=TwoWay}"
                                                Toggled="Mod_Toggled" Tag="{Binding Id}" VerticalAlignment="Center" />
                            </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <c:InfoBar x:Name="Estado" Grid.Row="3" Margin="0,14,0,0" IsOpen="False" IsClosable="True" Severity="Informational" />
    </Grid>
</c:PaginaBase>
