<?xml version="1.0" encoding="utf-8"?>
<c:PaginaBase
    x:Class="CentroAether.Pages.InicioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CentroAether.Controles">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,28,32,24">
        <c:Pila Spacing="20" MaxWidth="900" HorizontalAlignment="Left">

            <c:Pila Spacing="4">
                <TextBlock Text="Aether" FontSize="34" FontWeight="SemiBold" />
                <TextBlock Text="Tu Windows, optimizado. Elige un modo, repara la red o personaliza con Wind-Aether desde el menu de la izquierda."
                           Foreground="{StaticResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </c:Pila>

            <Border Background="{StaticResource LayerFillColorDefaultBrush}"
                    BorderBrush="{StaticResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="18">
                <c:Pila Spacing="12">
                    <TextBlock Text="Tema" FontWeight="SemiBold" FontSize="15" />
                    <c:Pila Orientation="Horizontal" Spacing="10">
                        <Button x:Name="BtnOscuro" Click="Oscuro_Click">
                            <c:Pila Orientation="Horizontal" Spacing="8">
                                <c:FontIcon Glyph="&#xE708;" /><TextBlock Text="Tema oscuro" />
                            </c:Pila>
                        </Button>
                        <Button x:Name="BtnClaro" Click="Claro_Click">
                            <c:Pila Orientation="Horizontal" Spacing="8">
                                <c:FontIcon Glyph="&#xE706;" /><TextBlock Text="Tema claro" />
                            </c:Pila>
                        </Button>
                    </c:Pila>
                    <TextBlock Text="Los colores de Wind-Aether se ajustan solos al tema."
                               Foreground="{StaticResource TextFillColorSecondaryBrush}" />
                </c:Pila>
            </Border>

            <Border Background="{StaticResource LayerFillColorDefaultBrush}"
                    BorderBrush="{StaticResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="18">
                <c:Pila Orientation="Horizontal" Spacing="14">
                    <c:FontIcon Glyph="&#xE7F4;" FontSize="22" VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtResumen" VerticalAlignment="Center" Text="Cargando estado..." />
                </c:Pila>
            </Border>

            <c:InfoBar x:Name="Estado" IsOpen="False" IsClosable="True" Severity="Informational" />
        </c:Pila>
    </ScrollViewer>
</c:PaginaBase>
