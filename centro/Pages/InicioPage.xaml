<?xml version="1.0" encoding="utf-8"?>
<c:PaginaBase
    x:Class="CentroAether.Pages.InicioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CentroAether.Controles">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <c:Pila Padding="36,30,36,36" Spacing="12" MaxWidth="1000">

            <!-- Portada -->
            <Border CornerRadius="16" Padding="30,26">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2F8CFF" Offset="0" />
                        <GradientStop Color="#1A4FA8" Offset="0.45" />
                        <GradientStop Color="#0E2A55" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <c:Pila VerticalAlignment="Center" Spacing="6">
                        <TextBlock Text="Bienvenido a Aether" FontSize="30" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock Text="Tu Windows, optimizado para trabajar y jugar. Todo se controla desde aquí."
                                   FontSize="14.5" Foreground="#DDE9FF" TextWrapping="Wrap" />
                    </c:Pila>
                    <c:Pila Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="20,0,0,0" VerticalAlignment="Center">
                        <Border CornerRadius="12" Padding="18,12" Background="#26FFFFFF" MinWidth="130">
                            <c:Pila Spacing="2">
                                <TextBlock Text="Modo" FontSize="12" Foreground="#DDE9FF" />
                                <TextBlock x:Name="TxtModoHero" Text="…" FontSize="20" FontWeight="SemiBold" Foreground="White" />
                            </c:Pila>
                        </Border>
                        <Border x:Name="ChipBateria" CornerRadius="12" Padding="18,12" Background="#26FFFFFF" MinWidth="130">
                            <c:Pila Spacing="2">
                                <TextBlock Text="Batería" FontSize="12" Foreground="#DDE9FF" />
                                <TextBlock x:Name="TxtBateriaHero" Text="…" FontSize="20" FontWeight="SemiBold" Foreground="White" />
                            </c:Pila>
                        </Border>
                    </c:Pila>
                </Grid>
            </Border>

            <c:InfoBar x:Name="Estado" IsOpen="False" IsClosable="True" Severity="Informational" />

            <TextBlock Text="Cambiar de modo" Style="{StaticResource SeccionTextBlockStyle}" />
            <UniformGrid x:Name="GridModos" Columns="3" Margin="0,0,-12,-12" />

            <TextBlock Text="Accesos rápidos" Style="{StaticResource SeccionTextBlockStyle}" />
            <UniformGrid x:Name="GridAccesos" Columns="4" Margin="0,0,-12,-12" />

            <TextBlock Text="Apariencia" Style="{StaticResource SeccionTextBlockStyle}" />
            <c:FilaAjuste Glyph="&#xE790;" Titulo="Tema de Windows"
                          Descripcion="Cambia Windows a claro u oscuro. Los colores de Wind-Aether se ajustan solos.">
                <c:Pila Orientation="Horizontal" Spacing="8">
                    <Button x:Name="BtnOscuro" Click="Oscuro_Click">
                        <c:Pila Orientation="Horizontal" Spacing="8">
                            <c:FontIcon Glyph="&#xE708;" FontSize="14" />
                            <TextBlock Text="Oscuro" />
                        </c:Pila>
                    </Button>
                    <Button x:Name="BtnClaro" Click="Claro_Click">
                        <c:Pila Orientation="Horizontal" Spacing="8">
                            <c:FontIcon Glyph="&#xE706;" FontSize="14" />
                            <TextBlock Text="Claro" />
                        </c:Pila>
                    </Button>
                </c:Pila>
            </c:FilaAjuste>
        </c:Pila>
    </ScrollViewer>
</c:PaginaBase>
