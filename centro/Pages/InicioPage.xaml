<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CentroAether.Pages.InicioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="32,28,32,24">
        <StackPanel Spacing="20" MaxWidth="900" HorizontalAlignment="Left">

            <StackPanel Spacing="4">
                <TextBlock Text="Aether" FontSize="34" FontWeight="SemiBold" />
                <TextBlock Text="Tu Windows, optimizado. Elige un modo, repara la red o personaliza con Wind-Aether desde el menu de la izquierda."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="18">
                <StackPanel Spacing="12">
                    <TextBlock Text="Tema" FontWeight="SemiBold" FontSize="15" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="BtnOscuro" Click="Oscuro_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE708;" /><TextBlock Text="Tema oscuro" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnClaro" Click="Claro_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE706;" /><TextBlock Text="Tema claro" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="Los colores de Wind-Aether se ajustan solos al tema."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="18">
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <FontIcon Glyph="&#xE7F4;" FontSize="22" VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtResumen" VerticalAlignment="Center" Text="Cargando estado..." />
                </StackPanel>
            </Border>

            <InfoBar x:Name="Estado" IsOpen="False" IsClosable="True" Severity="Informational" />
        </StackPanel>
    </ScrollViewer>
</Page>
