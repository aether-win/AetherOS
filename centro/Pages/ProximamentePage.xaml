<?xml version="1.0" encoding="utf-8"?>
<c:PaginaBase
    x:Class="CentroAether.Pages.ProximamentePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CentroAether.Controles">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <c:Pila Padding="36,30,36,36" Spacing="8" MaxWidth="1000">
            <c:Encabezado x:Name="Cabecera" Titulo="Módulo">
                <Border CornerRadius="14" Padding="14,6" Background="#163A5C" BorderBrush="#4FC3F7" BorderThickness="1">
                    <TextBlock Text="Próximamente" FontWeight="SemiBold" Foreground="#4FC3F7" />
                </Border>
            </c:Encabezado>

            <TextBlock Text="Qué hará este módulo" Style="{StaticResource SeccionTextBlockStyle}" />
            <Border Style="{StaticResource TarjetaStyle}">
                <ItemsControl x:Name="ListaCaracteristicas">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <c:FontIcon Glyph="&#xE73E;" FontSize="13" Margin="0,2,10,0" VerticalAlignment="Top"
                                            Foreground="{StaticResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <TextBlock Text="En desarrollo. Las funciones se irán activando por fases." FontSize="12.5" Margin="2,4,0,0"
                       Foreground="{StaticResource TextFillColorTertiaryBrush}" />
        </c:Pila>
    </ScrollViewer>
</c:PaginaBase>
