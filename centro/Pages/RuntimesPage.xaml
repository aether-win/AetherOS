<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CentroAether.Pages.RuntimesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="32,28,32,28" Spacing="18" MaxWidth="760" HorizontalAlignment="Left">

            <StackPanel Spacing="2">
                <TextBlock Text="Runtimes" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Componentes que los juegos y programas necesitan. Se instalan desde los paquetes oficiales de Microsoft."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <Button x:Name="BtnRefrescar" Click="Refrescar_Click" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="16" />
                    <TextBlock Text="Volver a comprobar" />
                </StackPanel>
            </Button>

            <InfoBar x:Name="Estado" IsOpen="False" IsClosable="True" Severity="Informational" />

            <StackPanel x:Name="Contenedor" Spacing="12" />
        </StackPanel>
    </ScrollViewer>
</Page>
