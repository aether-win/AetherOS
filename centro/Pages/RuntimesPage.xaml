<?xml version="1.0" encoding="utf-8"?>
<c:PaginaBase
    x:Class="CentroAether.Pages.RuntimesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CentroAether.Controles">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <c:Pila Padding="36,30,36,36" Spacing="8" MaxWidth="1000">
            <c:Encabezado Glyph="&#xE943;" ColorIcono="#22D3EE" Titulo="Runtimes" Subtitulo="Componentes que los juegos y programas necesitan, desde los paquetes oficiales de Microsoft.">
                <Button x:Name="BtnRefrescar" Click="Refrescar_Click">
                    <c:Pila Orientation="Horizontal" Spacing="8">
                        <c:FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="Volver a comprobar" />
                    </c:Pila>
                </Button>
            </c:Encabezado>
            <c:InfoBar x:Name="Estado" IsOpen="False" IsClosable="True" Severity="Informational" Margin="0,0,0,4" />

            <c:Pila x:Name="Contenedor" Spacing="8" Margin="0,8,0,0" />
        </c:Pila>
    </ScrollViewer>
</c:PaginaBase>
