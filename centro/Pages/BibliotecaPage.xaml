<?xml version="1.0" encoding="utf-8"?>
<c:PaginaBase
    x:Class="CentroAether.Pages.BibliotecaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CentroAether.Controles">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <c:Pila Padding="36,30,36,36" Spacing="8" MaxWidth="1000">
            <c:Encabezado Glyph="&#xE7FC;" Titulo="Biblioteca" Subtitulo="Tus juegos de Steam detectados en este equipo.">
                <Button x:Name="BtnRefrescar" Click="Refrescar_Click">
                    <c:Pila Orientation="Horizontal" Spacing="8">
                        <c:FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="Volver a buscar" />
                    </c:Pila>
                </Button>
            </c:Encabezado>
            <c:InfoBar x:Name="Estado" IsOpen="False" IsClosable="True" Severity="Informational" Margin="0,0,0,4" />

            <c:FilaAjuste Glyph="&#xE945;" Titulo="Activar Modo Gaming al jugar"
                          Descripcion="Al pulsar Jugar, cambia a Modo Gaming y muestra la animación antes de abrir el juego.">
                <c:ToggleSwitch x:Name="ModoAlJugar" />
            </c:FilaAjuste>

            <TextBlock Text="Juegos" Style="{StaticResource SeccionTextBlockStyle}" />
            <UniformGrid x:Name="Contenedor" Columns="2" Margin="0,0,-10,-10" />
            <c:FilaAjuste x:Name="Vacio" Glyph="&#xE7FC;" Titulo="No se detectaron juegos de Steam"
                          Descripcion="Instala Steam desde la sección Software y vuelve a buscar." Visibility="Collapsed" />
        </c:Pila>
    </ScrollViewer>
</c:PaginaBase>
