<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CentroAether.Pages.BibliotecaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="32,28,32,28" Spacing="16" MaxWidth="820" HorizontalAlignment="Left">

            <StackPanel Spacing="2">
                <TextBlock Text="Biblioteca" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Tus juegos de Steam detectados en el equipo."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <ToggleSwitch x:Name="ModoAlJugar" OffContent="Activar Modo Gaming al jugar"
                                  OnContent="Activar Modo Gaming al jugar" />
                </StackPanel>
                <Button x:Name="BtnRefrescar" Click="Refrescar_Click" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="16" />
                        <TextBlock Text="Volver a buscar" />
                    </StackPanel>
                </Button>
            </Grid>

            <InfoBar x:Name="Estado" IsOpen="False" IsClosable="True" Severity="Informational" />

            <StackPanel x:Name="Contenedor" Spacing="10" />

            <StackPanel x:Name="Vacio" Spacing="8" Visibility="Collapsed"
                        HorizontalAlignment="Center" Padding="0,32,0,0">
                <FontIcon Glyph="&#xE7FC;" FontSize="34"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="No se detectaron juegos de Steam"
                           Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock Text="Instala Steam desde la sección Software y vuelve a buscar."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
