<?xml version="1.0" encoding="utf-8"?>
<c:PaginaBase
    x:Class="CentroAether.Pages.BibliotecaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CentroAether.Controles">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <c:Pila Padding="32,28,32,28" Spacing="16" MaxWidth="820" HorizontalAlignment="Left">

            <c:Pila Spacing="2">
                <TextBlock Text="Biblioteca" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Tus juegos de Steam detectados en el equipo."
                           Foreground="{StaticResource TextFillColorSecondaryBrush}" />
            </c:Pila>

            <Grid>
                <c:Pila Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <c:ToggleSwitch x:Name="ModoAlJugar" OffContent="Activar Modo Gaming al jugar"
                                  OnContent="Activar Modo Gaming al jugar" />
                </c:Pila>
                <Button x:Name="BtnRefrescar" Click="Refrescar_Click" HorizontalAlignment="Right">
                    <c:Pila Orientation="Horizontal" Spacing="8">
                        <c:FontIcon Glyph="&#xE72C;" FontSize="16" />
                        <TextBlock Text="Volver a buscar" />
                    </c:Pila>
                </Button>
            </Grid>

            <c:InfoBar x:Name="Estado" IsOpen="False" IsClosable="True" Severity="Informational" />

            <c:Pila x:Name="Contenedor" Spacing="10" />

            <c:Pila x:Name="Vacio" Spacing="8" Visibility="Collapsed"
                        HorizontalAlignment="Center" Padding="0,32,0,0">
                <c:FontIcon Glyph="&#xE7FC;" FontSize="34"
                          Foreground="{StaticResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="No se detectaron juegos de Steam"
                           Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock Text="Instala Steam desde la sección Software y vuelve a buscar."
                           Foreground="{StaticResource TextFillColorSecondaryBrush}"
                           TextAlignment="Center" TextWrapping="Wrap" />
            </c:Pila>
        </c:Pila>
    </ScrollViewer>
</c:PaginaBase>
