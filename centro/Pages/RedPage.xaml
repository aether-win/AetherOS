<?xml version="1.0" encoding="utf-8"?>
<c:PaginaBase
    x:Class="CentroAether.Pages.RedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CentroAether.Controles">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <c:Pila Padding="36,30,36,36" Spacing="8" MaxWidth="1000">
            <c:Encabezado Glyph="&#xE839;" ColorIcono="#22D3EE" Titulo="Red y carpetas compartidas" Subtitulo="Diagnostica, repara y administra la red de este equipo.">
                <Border CornerRadius="14" Padding="14,6" Background="#123A4A" BorderBrush="#22D3EE" BorderThickness="1">
                    <c:Pila Orientation="Horizontal" Spacing="8">
                        <c:FontIcon Glyph="&#xE977;" FontSize="14" />
                        <TextBlock x:Name="TxtEquipo" Text="…" FontWeight="SemiBold" />
                    </c:Pila>
                </Border>
            </c:Encabezado>
            <c:InfoBar x:Name="Estado" IsOpen="False" IsClosable="True" Severity="Informational" Margin="0,0,0,4" />

            <TextBlock Text="Reparación" Style="{StaticResource SeccionTextBlockStyle}" />
            <c:FilaAjuste Glyph="&#xE90F;" Titulo="Diagnosticar y reparar la red"
                          Descripcion="Revisa y arregla uso compartido, impresión, detección de equipos y conexión. Resuelve el error 0x80070035.">
                <Button x:Name="BtnReparar" Content="Reparar" Style="{StaticResource AccentButtonStyle}" Click="Reparar_Click" />
            </c:FilaAjuste>

            <c:FilaAjuste Glyph="&#xE968;" Titulo="Probar con otra PC"
                          Descripcion="Escribe el nombre o la IP de la PC a la que quieres entrar (ej. PC10 o 192.168.1.10).">
                <c:Pila Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="TxtProbarEquipo" Width="180" Tag="PC10 o 192.168.1.10" />
                    <Button Content="Probar" Click="Probar_Click" />
                </c:Pila>
            </c:FilaAjuste>
            <c:FilaAjuste Glyph="&#xE8C8;" Titulo="Reparador para la otra PC"
                          Descripcion="Copia el reparador al Escritorio para llevarlo a la otra PC en una USB.">
                <Button Content="Guardar en el Escritorio" Click="GuardarReparador_Click" />
            </c:FilaAjuste>

            <TextBlock Text="Compartir" Style="{StaticResource SeccionTextBlockStyle}" />
            <c:FilaAjuste Glyph="&#xE72E;" Titulo="Hacer privada la red conectada"
                          Descripcion="Necesario para compartir carpetas e impresoras con otras PC de tu red.">
                <Button x:Name="BtnPrivada" Content="Hacer privada" Click="Privada_Click" />
            </c:FilaAjuste>
            <c:FilaAjuste Glyph="&#xE713;" Titulo="Opciones de uso compartido"
                          Descripcion="Abre la configuración avanzada de uso compartido de Windows.">
                <Button x:Name="BtnCompartir" Content="Abrir" Click="Compartir_Click" />
            </c:FilaAjuste>

            <TextBlock Text="Unidades de red fijas" Style="{StaticResource SeccionTextBlockStyle}" />
            <c:FilaAjuste Glyph="&#xE8CE;" Titulo="Agregar carpeta de otra PC como unidad"
                          Descripcion="Ejemplo: \\192.168.1.10\SISTEMA EF RED. Queda fija, se reconecta sola y lista para las macros de Excel.">
                <c:FilaAjuste.Debajo>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="CmbLetra" Grid.Column="0" Margin="0,0,8,0" />
                        <TextBox x:Name="TxtRutaRed" Grid.Column="1" Tag="\\IP-de-la-otra-PC\Carpeta" Margin="0,0,8,0" />
                        <Button x:Name="BtnAgregarUnidad" Grid.Column="2" Content="Agregar" Style="{StaticResource AccentButtonStyle}" Click="AgregarUnidad_Click" />
                    </Grid>
                </c:FilaAjuste.Debajo>
            </c:FilaAjuste>
            <StackPanel x:Name="PanelUnidades" />
            <c:FilaAjuste Glyph="&#xE72C;" Titulo="Reconectar las unidades ahora"
                          Descripcion="Aether las reconecta solo cada minuto; esto lo hace al instante.">
                <Button Content="Reconectar" Click="Reconectar_Click" />
            </c:FilaAjuste>
        </c:Pila>
    </ScrollViewer>
</c:PaginaBase>
