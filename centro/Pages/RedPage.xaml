<?xml version="1.0" encoding="utf-8"?>
<c:PaginaBase
    x:Class="CentroAether.Pages.RedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CentroAether.Controles">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,24,32,24">
        <c:Pila Spacing="18" MaxWidth="900" HorizontalAlignment="Left">

            <c:Pila Orientation="Horizontal" Spacing="12">
                <c:FontIcon Glyph="&#xE839;" FontSize="28" />
                <c:Pila>
                    <TextBlock Text="Red y carpetas compartidas" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="Diagnostica, repara y administra la red de este equipo."
                               Foreground="{StaticResource TextFillColorSecondaryBrush}" />
                </c:Pila>
            </c:Pila>

            <Button x:Name="BtnReparar" HorizontalAlignment="Stretch" Height="52"
                    Style="{StaticResource AccentButtonStyle}" Click="Reparar_Click">
                <c:Pila Orientation="Horizontal" Spacing="10">
                    <c:FontIcon Glyph="&#xE90F;" /><TextBlock Text="Diagnosticar y reparar la red" />
                </c:Pila>
            </Button>

            <Button x:Name="BtnPrivada" HorizontalAlignment="Stretch" Height="48" Click="Privada_Click">
                <c:Pila Orientation="Horizontal" Spacing="10">
                    <c:FontIcon Glyph="&#xE72E;" /><TextBlock Text="Hacer privada la red conectada (para compartir carpetas)" />
                </c:Pila>
            </Button>

            <Button x:Name="BtnCompartir" HorizontalAlignment="Stretch" Height="48" Click="Compartir_Click">
                <c:Pila Orientation="Horizontal" Spacing="10">
                    <c:FontIcon Glyph="&#xE713;" /><TextBlock Text="Abrir opciones de uso compartido" />
                </c:Pila>
            </Button>

            <Border Background="{StaticResource LayerFillColorDefaultBrush}"
                    BorderBrush="{StaticResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <c:Pila Orientation="Horizontal" Spacing="12">
                    <c:FontIcon Glyph="&#xE946;" VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtEquipo" VerticalAlignment="Center" Text="Este equipo: ..." />
                </c:Pila>
            </Border>

            <c:InfoBar x:Name="Estado" IsOpen="False" IsClosable="True" Severity="Informational" />

        </c:Pila>
    </ScrollViewer>
</c:PaginaBase>
