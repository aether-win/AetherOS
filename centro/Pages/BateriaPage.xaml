<?xml version="1.0" encoding="utf-8"?>
<c:PaginaBase
    x:Class="CentroAether.Pages.BateriaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CentroAether.Controles">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,24,32,24">
        <c:Pila Spacing="18" MaxWidth="900" HorizontalAlignment="Left">
            <c:Pila Orientation="Horizontal" Spacing="12">
                <c:FontIcon Glyph="&#xE83E;" FontSize="28" />
                <c:Pila>
                    <TextBlock Text="Bateria" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="Carga actual y modo bateria automatico."
                               Foreground="{StaticResource TextFillColorSecondaryBrush}" />
                </c:Pila>
            </c:Pila>

            <Border Background="{StaticResource LayerFillColorDefaultBrush}"
                    BorderBrush="{StaticResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="18">
                <c:Pila Orientation="Horizontal" Spacing="14">
                    <c:FontIcon Glyph="&#xE83E;" FontSize="24" />
                    <TextBlock x:Name="TxtCarga" VerticalAlignment="Center" FontSize="16"
                               FontWeight="SemiBold" Text="Carga: ..." />
                </c:Pila>
            </Border>

            <Border Background="{StaticResource LayerFillColorDefaultBrush}"
                    BorderBrush="{StaticResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="18">
                <c:Pila Spacing="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <c:Pila Grid.Column="0" Spacing="2">
                            <TextBlock Text="Modo Bateria automatico" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="Cambia solo al Modo Bateria cuando bajas del nivel elegido y no estas con cargador."
                                       Foreground="{StaticResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </c:Pila>
                        <c:ToggleSwitch x:Name="SwAuto" Grid.Column="1" VerticalAlignment="Center" Toggled="Auto_Toggled" />
                    </Grid>
                    <c:Pila Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="Activar al llegar a" VerticalAlignment="Center" />
                        <ComboBox x:Name="CmbUmbral" Width="80" SelectionChanged="Umbral_Changed" />
                        <TextBlock Text="sin cargador." VerticalAlignment="Center" />
                    </c:Pila>
                </c:Pila>
            </Border>

            <Border Background="{StaticResource LayerFillColorDefaultBrush}"
                    BorderBrush="{StaticResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <c:Pila Grid.Column="0" Spacing="2">
                        <TextBlock Text="Limitar turbo en Gaming" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock Text="En Modo Gaming, baja el turbo del procesador para darle mas energia a la grafica integrada."
                                   Foreground="{StaticResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </c:Pila>
                    <c:ToggleSwitch x:Name="SwTurbo" Grid.Column="1" VerticalAlignment="Center" Toggled="Turbo_Toggled" />
                </Grid>
            </Border>

            <c:InfoBar x:Name="Estado" IsOpen="False" IsClosable="True" Severity="Informational" />
        </c:Pila>
    </ScrollViewer>
</c:PaginaBase>
