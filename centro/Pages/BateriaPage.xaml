<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CentroAether.Pages.BateriaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="32,24,32,24">
        <StackPanel Spacing="18" MaxWidth="900" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon Glyph="&#xE83E;" FontSize="28" />
                <StackPanel>
                    <TextBlock Text="Bateria" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="Carga actual y modo bateria automatico."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="18">
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <FontIcon Glyph="&#xE83E;" FontSize="24" />
                    <TextBlock x:Name="TxtCarga" VerticalAlignment="Center" FontSize="16"
                               FontWeight="SemiBold" Text="Carga: ..." />
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="18">
                <StackPanel Spacing="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Modo Bateria automatico" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="Cambia solo al Modo Bateria cuando bajas del nivel elegido y no estas con cargador."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch x:Name="SwAuto" Grid.Column="1" VerticalAlignment="Center" Toggled="Auto_Toggled" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="Activar al llegar a" VerticalAlignment="Center" />
                        <ComboBox x:Name="CmbUmbral" Width="80" SelectionChanged="Umbral_Changed" />
                        <TextBlock Text="sin cargador." VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="Limitar turbo en Gaming" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock Text="En Modo Gaming, baja el turbo del procesador para darle mas energia a la grafica integrada."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch x:Name="SwTurbo" Grid.Column="1" VerticalAlignment="Center" Toggled="Turbo_Toggled" />
                </Grid>
            </Border>

            <InfoBar x:Name="Estado" IsOpen="False" IsClosable="True" Severity="Informational" />
        </StackPanel>
    </ScrollViewer>
</Page>
