<?xml version="1.0" encoding="utf-8"?>
<c:PaginaBase
    x:Class="CentroAether.Pages.BateriaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CentroAether.Controles">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <c:Pila Padding="36,30,36,36" Spacing="8" MaxWidth="1000">
            <c:Encabezado Glyph="&#xE83E;" ColorIcono="#2FA86A" Titulo="Batería" Subtitulo="Carga actual y Modo Batería automático." />
            <c:InfoBar x:Name="Estado" IsOpen="False" IsClosable="True" Severity="Informational" Margin="0,0,0,4" />

            <Border Style="{StaticResource TarjetaStyle}" Padding="24,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <c:FontIcon Glyph="&#xE83F;" FontSize="44" Foreground="#3FBF7F" Margin="0,0,20,0" />
                    <c:Pila Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtCarga" Text="…" FontSize="26" FontWeight="SemiBold" />
                        <ProgressBar x:Name="BarraCarga" Minimum="0" Maximum="100" Value="0" Height="8" Foreground="#3FBF7F" />
                    </c:Pila>
                </Grid>
            </Border>

            <TextBlock Text="Modo Batería" Style="{StaticResource SeccionTextBlockStyle}" />
            <c:FilaAjuste Glyph="&#xE945;" Titulo="Modo Batería automático"
                          Descripcion="Cambia solo al Modo Batería cuando bajas del nivel elegido y no estás con el cargador.">
                <c:ToggleSwitch x:Name="SwAuto" Toggled="Auto_Toggled" />
            </c:FilaAjuste>
            <c:FilaAjuste Glyph="&#xE9E9;" Titulo="Activar al llegar a"
                          Descripcion="Nivel de batería (sin cargador) en el que entra el Modo Batería.">
                <ComboBox x:Name="CmbUmbral" Width="96" SelectionChanged="Umbral_Changed" />
            </c:FilaAjuste>

            <TextBlock Text="Rendimiento" Style="{StaticResource SeccionTextBlockStyle}" />
            <c:FilaAjuste Glyph="&#xE7FC;" Titulo="Limitar turbo en Gaming"
                          Descripcion="En Modo Gaming baja el turbo del procesador para darle más energía a la gráfica integrada.">
                <c:ToggleSwitch x:Name="SwTurbo" Toggled="Turbo_Toggled" />
            </c:FilaAjuste>
        </c:Pila>
    </ScrollViewer>
</c:PaginaBase>
