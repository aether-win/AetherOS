<?xml version="1.0" encoding="utf-8"?>
<c:PaginaBase
    x:Class="CentroAether.Pages.ActualizarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CentroAether.Controles">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <c:Pila Padding="36,30,36,36" Spacing="8" MaxWidth="1000">
            <c:Encabezado Glyph="&#xE895;" Titulo="Actualizaciones" Subtitulo="Controla Windows Update y mantén al día tus programas." />
            <c:InfoBar x:Name="Estado" IsOpen="False" IsClosable="True" Severity="Informational" Margin="0,0,0,4" />

            <TextBlock Text="Windows" Style="{StaticResource SeccionTextBlockStyle}" />
            <c:FilaAjuste Glyph="&#xE769;" Titulo="Mantener Windows Update en pausa"
                          Descripcion="Aether deja Windows sin actualizarse solo. Apaga esto cuando quieras actualizar y vuelve a encenderlo después.">
                <c:ToggleSwitch x:Name="SwPausa" OnContent="En pausa" OffContent="Activo" Toggled="SwPausa_Toggled" />
            </c:FilaAjuste>

            <TextBlock Text="Programas" Style="{StaticResource SeccionTextBlockStyle}" />
            <c:FilaAjuste Glyph="&#xE896;" Titulo="Actualizar mis programas"
                          Descripcion="Busca versiones nuevas de los programas instalados (navegadores, apps, etc.) y las instala.">
                <Button x:Name="BtnApps" Content="Actualizar" Style="{StaticResource AccentButtonStyle}" Click="BtnApps_Click" />
            </c:FilaAjuste>
            <TextBlock Text="Edge" Style="{StaticResource SeccionTextBlockStyle}" />
            <c:FilaAjuste Glyph="&#xE721;" Titulo="Google como buscador en Edge"
                          Descripcion="Abre la página de buscadores de Edge para elegir Google (Aether lo repone solo si vuelve Bing).">
                <Button Content="Abrir" Click="EdgeGoogle_Click" />
            </c:FilaAjuste>
        </c:Pila>
    </ScrollViewer>
</c:PaginaBase>
