<?xml version="1.0" encoding="utf-8"?>
<c:PaginaBase
    x:Class="CentroAether.Pages.ActualizarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CentroAether.Controles">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,24,32,24">
        <c:Pila Spacing="18" MaxWidth="900" HorizontalAlignment="Left">

            <c:Pila Orientation="Horizontal" Spacing="12">
                <c:FontIcon Glyph="&#xE895;" FontSize="28" />
                <c:Pila>
                    <TextBlock Text="Actualizaciones" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="Controla Windows Update y actualiza tus programas."
                               Foreground="{StaticResource TextFillColorSecondaryBrush}" />
                </c:Pila>
            </c:Pila>

            <Border Background="{StaticResource LayerFillColorDefaultBrush}"
                    BorderBrush="{StaticResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <c:Pila Grid.Column="0" Spacing="2">
                        <TextBlock Text="Mantener Windows Update en pausa" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock Text="Aether deja Windows sin actualizarse solo. Apaga esto para actualizar."
                                   Foreground="{StaticResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </c:Pila>
                    <c:ToggleSwitch x:Name="SwPausa" Grid.Column="1" VerticalAlignment="Center"
                                  OnContent="En pausa" OffContent="Activo" Toggled="SwPausa_Toggled" />
                </Grid>
            </Border>

            <Border Background="{StaticResource LayerFillColorDefaultBrush}"
                    BorderBrush="{StaticResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <c:Pila Grid.Column="0" Spacing="2">
                        <TextBlock Text="Actualizar mis programas" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock Text="Busca una version mas nueva de los programas instalados (Chrome, apps, etc.) y los actualiza."
                                   Foreground="{StaticResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </c:Pila>
                    <Button x:Name="BtnApps" Grid.Column="1" VerticalAlignment="Center"
                            Content="Actualizar" Click="BtnApps_Click" />
                </Grid>
            </Border>

            <c:InfoBar x:Name="Estado" IsOpen="False" IsClosable="True" Severity="Informational" />

        </c:Pila>
    </ScrollViewer>
</c:PaginaBase>
