<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CentroAether.Pages.ControllerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="32,28,32,28" Spacing="16" MaxWidth="760" HorizontalAlignment="Left">

            <StackPanel Spacing="2">
                <TextBlock Text="Control" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Aether Controller: mandos conectados a tu equipo."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Button x:Name="BtnRefrescar" Click="Refrescar_Click" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="16" />
                    <TextBlock Text="Volver a buscar mandos" />
                </StackPanel>
            </Button>

            <InfoBar x:Name="Estado" IsOpen="False" IsClosable="True" Severity="Informational" />

            <StackPanel x:Name="Contenedor" Spacing="10" />

            <StackPanel x:Name="Vacio" Spacing="6" Visibility="Collapsed"
                        HorizontalAlignment="Center" Padding="0,16,0,0">
                <FontIcon Glyph="&#xE7FC;" FontSize="32"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="No hay mandos conectados" Style="{StaticResource BodyStrongTextBlockStyle}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Conecta un mando por USB o Bluetooth y vuelve a buscar."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" />
            </StackPanel>

            <!-- Motor de mapeo -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="18">
                <StackPanel Spacing="10">
                    <TextBlock Text="Mapeo avanzado (en desarrollo)" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap" FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="El motor nativo de Aether Controller permitirá emular un mando Xbox 360, soportar DualShock 4 / DualSense / Switch Pro y guardar perfiles por juego. Se basará en DS4Windows (GPLv3, con crédito a sus autores)." />
                    <Button x:Name="BtnDs4" Content="Instalar DS4Windows (temporal)"
                            Click="Ds4_Click" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
