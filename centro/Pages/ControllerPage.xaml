<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CentroAether.Pages.ControllerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="32,28,32,28" Spacing="16" MaxWidth="760" HorizontalAlignment="Left">

            <StackPanel Spacing="2">
                <TextBlock Text="Control" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Aether Controller: mandos conectados a tu equipo."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Button x:Name="BtnRefrescar" Click="Refrescar_Click" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="16" />
                    <TextBlock Text="Volver a buscar mandos" />
                </StackPanel>
            </Button>

            <InfoBar x:Name="Estado" IsOpen="False" IsClosable="True" Severity="Informational" />

            <StackPanel x:Name="Contenedor" Spacing="10" />

            <StackPanel x:Name="Vacio" Spacing="6" Visibility="Collapsed"
                        HorizontalAlignment="Center" Padding="0,16,0,0">
                <FontIcon Glyph="&#xE7FC;" FontSize="32"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="No hay mandos conectados" Style="{StaticResource BodyStrongTextBlockStyle}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Conecta un mando por USB o Bluetooth y vuelve a buscar."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" />
            </StackPanel>

            <!-- Emulación Xbox 360 (motor nativo) -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="18">
                <StackPanel Spacing="12">
                    <Grid>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Emulación de mando Xbox 360" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="TxtMotor" Text="…" FontSize="13" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="TglEmular" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Toggled="Emular_Toggled" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="Convertir a:" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ComboBox x:Name="CmbObjetivo" MinWidth="160" SelectionChanged="Objetivo_Changed">
                            <ComboBoxItem Content="Xbox 360" />
                            <ComboBoxItem Content="DualShock 4" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel x:Name="PanelRequisitos" Orientation="Horizontal" Spacing="10" Visibility="Collapsed">
                        <Button x:Name="BtnVigem" Content="Instalar ViGEmBus" Click="Vigem_Click" />
                        <Button x:Name="BtnHidHide" Content="Instalar HidHide" Click="HidHide_Click" />
                    </StackPanel>

                    <TextBlock FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Text="Soporta mandos Xbox y, de forma experimental, DualShock 4 / DualSense (PS4/PS5). Instala HidHide para ocultar el mando original y evitar la entrada doble. Basado en la tecnología de DS4Windows (GPLv3)." />
                </StackPanel>
            </Border>

            <!-- Alternativa completa -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="18">
                <StackPanel Spacing="8">
                    <TextBlock Text="¿Necesitas mapeo avanzado ya?" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap" FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Mientras se amplía el motor nativo (perfiles por juego, giroscopio, luces), puedes usar DS4Windows para el set completo de funciones." />
                    <Button x:Name="BtnDs4" Content="Instalar DS4Windows"
                            Click="Ds4_Click" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
