<?xml version="1.0" encoding="utf-8"?>
<c:PaginaBase
    x:Class="CentroAether.Pages.ControllerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CentroAether.Controles">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <c:Pila Padding="32,28,32,28" Spacing="16" MaxWidth="760" HorizontalAlignment="Left">

            <c:Pila Spacing="2">
                <TextBlock Text="Control" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Aether Controller: mandos conectados a tu equipo."
                           Foreground="{StaticResource TextFillColorSecondaryBrush}" />
            </c:Pila>

            <Button x:Name="BtnRefrescar" Click="Refrescar_Click" HorizontalAlignment="Left">
                <c:Pila Orientation="Horizontal" Spacing="8">
                    <c:FontIcon Glyph="&#xE72C;" FontSize="16" />
                    <TextBlock Text="Volver a buscar mandos" />
                </c:Pila>
            </Button>

            <c:InfoBar x:Name="Estado" IsOpen="False" IsClosable="True" Severity="Informational" />

            <c:Pila x:Name="Contenedor" Spacing="10" />

            <c:Pila x:Name="Vacio" Spacing="6" Visibility="Collapsed"
                        HorizontalAlignment="Center" Padding="0,16,0,0">
                <c:FontIcon Glyph="&#xE7FC;" FontSize="32"
                          Foreground="{StaticResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="No hay mandos conectados" Style="{StaticResource BodyStrongTextBlockStyle}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Conecta un mando por USB o Bluetooth y vuelve a buscar."
                           Foreground="{StaticResource TextFillColorSecondaryBrush}" TextAlignment="Center" />
            </c:Pila>

            <!-- Diagnóstico en vivo -->
            <Border Background="{StaticResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{StaticResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="18">
                <c:Pila Spacing="10">
                    <Grid>
                        <c:Pila VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Probar mando en vivo" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Pulsa botones y mueve los sticks para ver sus índices y valores (sirve para afinar el mapeo)."
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextFillColorSecondaryBrush}" />
                        </c:Pila>
                        <c:ToggleSwitch x:Name="TglDiag" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Toggled="Diag_Toggled" />
                    </Grid>
                    <Border x:Name="CajaDiag" Visibility="Collapsed"
                            Background="{StaticResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="12">
                        <TextBlock x:Name="TxtDiag" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                                   Text="Esperando lectura…" />
                    </Border>
                </c:Pila>
            </Border>

            <!-- Emulación Xbox 360 (motor nativo) -->
            <Border Background="{StaticResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{StaticResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="18">
                <c:Pila Spacing="12">
                    <Grid>
                        <c:Pila VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Emulación de mando Xbox 360" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="TxtMotor" Text="…" FontSize="13" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextFillColorSecondaryBrush}" />
                        </c:Pila>
                        <c:ToggleSwitch x:Name="TglEmular" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Toggled="Emular_Toggled" />
                    </Grid>

                    <c:Pila Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="Convertir a:" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextFillColorSecondaryBrush}" />
                        <ComboBox x:Name="CmbObjetivo" MinWidth="160" SelectionChanged="Objetivo_Changed">
                            <ComboBoxItem Content="Xbox 360" />
                            <ComboBoxItem Content="DualShock 4" />
                        </ComboBox>
                    </c:Pila>

                    <c:Pila Spacing="4">
                        <Grid>
                            <TextBlock Text="Zona muerta de sticks" FontSize="13"
                                       Foreground="{StaticResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="TxtDeadzone" Text="10%" HorizontalAlignment="Right" FontSize="13" />
                        </Grid>
                        <Slider x:Name="SldDeadzone" Minimum="0" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="Ajuste_Changed" />
                        <Grid>
                            <TextBlock Text="Sensibilidad" FontSize="13"
                                       Foreground="{StaticResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="TxtSens" Text="100%" HorizontalAlignment="Right" FontSize="13" />
                        </Grid>
                        <Slider x:Name="SldSens" Minimum="50" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True"
                                ValueChanged="Ajuste_Changed" />
                    </c:Pila>

                    <c:Pila x:Name="PanelRequisitos" Orientation="Horizontal" Spacing="10" Visibility="Collapsed">
                        <Button x:Name="BtnVigem" Content="Instalar ViGEmBus" Click="Vigem_Click" />
                        <Button x:Name="BtnHidHide" Content="Instalar HidHide" Click="HidHide_Click" />
                    </c:Pila>

                    <TextBlock FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource TextFillColorTertiaryBrush}"
                               Text="Soporta DualShock 4 (PS4) leído por HID y mandos Xbox. Instala HidHide para ocultar el mando original y evitar la entrada doble. Basado en la tecnología de DS4Windows (GPLv3)." />
                </c:Pila>
            </Border>

            <!-- Alternativa completa -->
            <Border Background="{StaticResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{StaticResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="18">
                <c:Pila Spacing="8">
                    <TextBlock Text="¿Necesitas mapeo avanzado ya?" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap" FontSize="13"
                               Foreground="{StaticResource TextFillColorSecondaryBrush}"
                               Text="Mientras se amplía el motor nativo (perfiles por juego, giroscopio, luces), puedes usar DS4Windows para el set completo de funciones." />
                    <Button x:Name="BtnDs4" Content="Instalar DS4Windows"
                            Click="Ds4_Click" HorizontalAlignment="Left" />
                </c:Pila>
            </Border>
        </c:Pila>
    </ScrollViewer>
</c:PaginaBase>
