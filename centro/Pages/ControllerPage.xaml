<?xml version="1.0" encoding="utf-8"?>
<c:PaginaBase
    x:Class="CentroAether.Pages.ControllerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CentroAether.Controles">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <c:Pila Padding="36,30,36,36" Spacing="8" MaxWidth="1000">
            <c:Encabezado Glyph="&#xE7FC;" Titulo="Control" Subtitulo="Usa tu mando de PS4 (DualShock 4) como un mando de Xbox.">
                <Button x:Name="BtnRefrescar" Click="Refrescar_Click">
                    <c:Pila Orientation="Horizontal" Spacing="8">
                        <c:FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="Buscar mandos" />
                    </c:Pila>
                </Button>
            </c:Encabezado>
            <c:InfoBar x:Name="Estado" IsOpen="False" IsClosable="True" Severity="Informational" Margin="0,0,0,4" />

            <c:FilaAjuste Glyph="&#xE7E8;" Titulo="Mandos de Aether"
                          Descripcion="Apágalo si no usas mandos: no corre nada de mandos (ni perfiles, ni sonidos, ni revisiones) y no toca ningún otro dispositivo.">
                <c:ToggleSwitch x:Name="TglMandos" Toggled="Mandos_Toggled" />
            </c:FilaAjuste>

            <c:Pila x:Name="PanelMandos" Spacing="8">
            <TextBlock Text="Mandos conectados" Style="{StaticResource SeccionTextBlockStyle}" />
            <c:Pila x:Name="Contenedor" Spacing="8" />
            <c:FilaAjuste x:Name="Vacio" Glyph="&#xE7FC;" ColorIcono="#6F87A3" Titulo="Ningún mando conectado"
                          Descripcion="Conecta un mando por USB o Bluetooth: aparece aquí al instante, con un punto verde." Visibility="Collapsed" />

            <TextBlock Text="Convertir mando" Style="{StaticResource SeccionTextBlockStyle}" />
            <c:FilaAjuste x:Name="FilaEmular" Glyph="&#xE7FC;" Titulo="Emulación de mando Xbox 360" Descripcion="…">
                <c:ToggleSwitch x:Name="TglEmular" Toggled="Emular_Toggled" />
            </c:FilaAjuste>
            <c:FilaAjuste Glyph="&#xE8AB;" Titulo="Convertir a" Descripcion="Tipo de mando virtual que verán los juegos.">
                <ComboBox x:Name="CmbObjetivo" Width="170" SelectionChanged="Objetivo_Changed">
                    <ComboBoxItem Content="Xbox 360" />
                    <ComboBoxItem Content="DualShock 4" />
                </ComboBox>
            </c:FilaAjuste>
            <c:FilaAjuste Glyph="&#xE9E9;" Titulo="Sticks" Descripcion="Zona muerta y sensibilidad de los sticks.">
                <c:FilaAjuste.Debajo>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <c:Pila Spacing="6" Margin="0,0,14,0">
                            <Grid>
                                <TextBlock Text="Zona muerta" FontSize="12.5" Foreground="{StaticResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="TxtDeadzone" Text="10%" HorizontalAlignment="Right" FontSize="12.5" FontWeight="SemiBold" />
                            </Grid>
                            <Slider x:Name="SldDeadzone" Minimum="0" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True"
                                    ValueChanged="Ajuste_Changed" />
                        </c:Pila>
                        <c:Pila Grid.Column="1" Spacing="6" Margin="14,0,0,0">
                            <Grid>
                                <TextBlock Text="Sensibilidad" FontSize="12.5" Foreground="{StaticResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="TxtSens" Text="100%" HorizontalAlignment="Right" FontSize="12.5" FontWeight="SemiBold" />
                            </Grid>
                            <Slider x:Name="SldSens" Minimum="50" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True"
                                    ValueChanged="Ajuste_Changed" />
                        </c:Pila>
                    </Grid>
                </c:FilaAjuste.Debajo>
            </c:FilaAjuste>
            <c:FilaAjuste x:Name="PanelRequisitos" Glyph="&#xE7BA;" ColorIcono="{StaticResource SystemFillColorCautionBrush}"
                          Titulo="Faltan drivers" Visibility="Collapsed"
                          Descripcion="ViGEmBus crea el mando virtual. HidHide oculta el mando original para evitar entrada doble.">
                <c:Pila Orientation="Horizontal" Spacing="8">
                    <Button x:Name="BtnVigem" Content="Instalar ViGEmBus" Style="{StaticResource AccentButtonStyle}" Click="Vigem_Click" />
                    <Button x:Name="BtnHidHide" Content="Instalar HidHide" Click="HidHide_Click" />
                </c:Pila>
            </c:FilaAjuste>

            <TextBlock Text="Bluetooth" Style="{StaticResource SeccionTextBlockStyle}" />
            <c:FilaAjuste Glyph="&#xE702;" Titulo="Apagar el mando Bluetooth sin uso"
                          Descripcion="Apaga solo el mando (como hace una PS4) tras ese tiempo sin tocarlo, para ahorrar su batería. El Bluetooth del equipo sigue encendido.">
                <c:Pila Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="TxtMinutos" Width="70" Tag="min" Visibility="Collapsed" LostFocus="Minutos_LostFocus" />
                    <ComboBox x:Name="CmbApagado" Width="150" SelectionChanged="Apagado_Changed" />
                </c:Pila>
            </c:FilaAjuste>

            <TextBlock Text="Diagnóstico" Style="{StaticResource SeccionTextBlockStyle}" />
            <c:FilaAjuste Glyph="&#xE9F9;" Titulo="Registro de mandos"
                          Descripcion="Conexiones, desconexiones, luz del mando y errores, con fecha y hora (mandos.log).">
                <Button Content="Abrir registro" Click="Registro_Click" />
            </c:FilaAjuste>
            <c:FilaAjuste Glyph="&#xE9D9;" Titulo="Probar mando en vivo"
                          Descripcion="Pulsa botones y mueve los sticks para ver sus índices y valores.">
                <c:ToggleSwitch x:Name="TglDiag" Toggled="Diag_Toggled" />
                <c:FilaAjuste.Debajo>
                    <Border x:Name="CajaDiag" Visibility="Collapsed" Background="#0A1726" BorderBrush="#1C3756"
                            BorderThickness="1" CornerRadius="8" Padding="14,12">
                        <TextBlock x:Name="TxtDiag" FontFamily="Cascadia Mono, Consolas" FontSize="12.5" TextWrapping="Wrap"
                                   Text="Esperando lectura…" />
                    </Border>
                </c:FilaAjuste.Debajo>
            </c:FilaAjuste>

            <TextBlock Text="Alternativa" Style="{StaticResource SeccionTextBlockStyle}" />
            <c:FilaAjuste Glyph="&#xE896;" Titulo="DS4Windows"
                          Descripcion="Si necesitas mapeo avanzado ya, DS4Windows tiene el set completo de funciones. Basado en su tecnología (GPLv3).">
                <Button x:Name="BtnDs4" Content="Instalar" Click="Ds4_Click" />
            </c:FilaAjuste>
            </c:Pila>
        </c:Pila>
    </ScrollViewer>
</c:PaginaBase>
