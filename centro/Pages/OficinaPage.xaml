<?xml version="1.0" encoding="utf-8"?>
<c:PaginaBase
    x:Class="CentroAether.Pages.OficinaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CentroAether.Controles">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <c:Pila Padding="36,30,36,36" Spacing="8" MaxWidth="1000">
            <c:Encabezado Glyph="&#xE8A5;" ColorIcono="#F2B33D" Titulo="Oficina" Subtitulo="Office, macros y comodidad para trabajar." />
            <c:InfoBar x:Name="Estado" IsOpen="False" IsClosable="True" Severity="Informational" Margin="0,0,0,4" />

            <TextBlock Text="Microsoft Office" Style="{StaticResource SeccionTextBlockStyle}" />
            <c:FilaAjuste x:Name="FilaOffice" Glyph="&#xE8A5;" Titulo="Office en este equipo" Descripcion="Comprobando…" />
            <c:FilaAjuste x:Name="FilaMacros" Glyph="&#xE72E;" Titulo="Seguridad de macros" Descripcion="…">
                <Button x:Name="BtnMacros" Content="Proteger macros" Click="Macros_Click" />
            </c:FilaAjuste>
            <c:FilaAjuste Glyph="&#xE73E;" ColorIcono="{StaticResource SystemFillColorSuccessBrush}" Titulo="Texto siempre visible en Office"
                          Descripcion="Las transparencias de los mods se desactivan en Word, Excel, PowerPoint, Outlook, OneNote y Access para que el texto nunca se vea invisible." />

            <TextBlock Text="Concentración" Style="{StaticResource SeccionTextBlockStyle}" />
            <c:FilaAjuste Glyph="&#xE708;" Titulo="Modo enfocado"
                          Descripcion="Silencia las notificaciones para concentrarte mientras trabajas.">
                <Button Content="Abrir ajustes" Click="Enfocado_Click" />
            </c:FilaAjuste>
        </c:Pila>
    </ScrollViewer>
</c:PaginaBase>
