<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CentroAether.Pages.OficinaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="32,28,32,28" Spacing="16" MaxWidth="760" HorizontalAlignment="Left">

            <StackPanel Spacing="2">
                <TextBlock Text="Oficina" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Protección de Office y comodidad para trabajar."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <InfoBar x:Name="Estado" IsOpen="False" IsClosable="True" Severity="Informational" />

            <!-- Office detectado -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="18,14,18,14">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE8A5;" FontSize="20" VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtOffice" Text="Comprobando Office…"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Macros -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="18,14,18,14">
                <Grid>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Seguridad de macros" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="TxtMacros" Text="…" FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button x:Name="BtnMacros" Content="Proteger macros" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Click="Macros_Click" />
                </Grid>
            </Border>

            <!-- Transparencias -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="18,14,18,14">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE73E;" FontSize="18" VerticalAlignment="Top" Margin="0,2,0,0"
                              Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                    <StackPanel Spacing="2">
                        <TextBlock Text="Texto siempre visible en Office" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Las transparencias de los mods se desactivan en Word, Excel, PowerPoint, Outlook, OneNote y Access para que el texto nunca se vea invisible."
                                   FontSize="13" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Modo enfocado -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="18,14,18,14">
                <Grid>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Modo enfocado" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Silencia notificaciones para concentrarte mientras trabajas."
                                   FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Content="Abrir ajustes" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Click="Enfocado_Click" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
