<?xml version="1.0" encoding="utf-8"?>
<c:PaginaBase
    x:Class="CentroAether.Pages.RespaldoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CentroAether.Controles">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <c:Pila Padding="36,30,36,36" Spacing="8" MaxWidth="1000">
            <c:Encabezado Glyph="&#xE8C8;" ColorIcono="#F2B33D" Titulo="Respaldo" Subtitulo="Copia tus archivos importantes a una carpeta o disco." />
            <c:InfoBar x:Name="Estado" IsOpen="False" IsClosable="True" Severity="Informational" Margin="0,0,0,4" />

            <TextBlock Text="1. Destino" Style="{StaticResource SeccionTextBlockStyle}" />
            <c:FilaAjuste x:Name="FilaDestino" Glyph="&#xE8B7;" Titulo="Dónde guardar el respaldo"
                          Descripcion="Sin carpeta elegida.">
                <Button x:Name="BtnCarpeta" Content="Elegir carpeta…" Click="Carpeta_Click" />
            </c:FilaAjuste>

            <TextBlock Text="2. Respaldar" Style="{StaticResource SeccionTextBlockStyle}" />
            <c:FilaAjuste Glyph="&#xE898;" Titulo="Hacer respaldo ahora"
                          Descripcion="Copia ahora tus archivos al destino elegido. Puede tardar según cuántos archivos tengas.">
                <Button x:Name="BtnRespaldar" Content="Respaldar" Style="{StaticResource AccentButtonStyle}"
                        Click="Respaldar_Click" IsEnabled="False" />
            </c:FilaAjuste>
        </c:Pila>
    </ScrollViewer>
</c:PaginaBase>
