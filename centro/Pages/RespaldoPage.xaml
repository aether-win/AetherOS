<?xml version="1.0" encoding="utf-8"?>
<c:PaginaBase
    x:Class="CentroAether.Pages.RespaldoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CentroAether.Controles">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,24,32,24">
        <c:Pila Spacing="18" MaxWidth="900" HorizontalAlignment="Left">
            <c:Pila Orientation="Horizontal" Spacing="12">
                <c:FontIcon Glyph="&#xE8C8;" FontSize="28" />
                <c:Pila>
                    <TextBlock Text="Respaldo" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="Copia tus archivos importantes a una carpeta o disco."
                               Foreground="{StaticResource TextFillColorSecondaryBrush}" />
                </c:Pila>
            </c:Pila>

            <Border Background="{StaticResource LayerFillColorDefaultBrush}"
                    BorderBrush="{StaticResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="18">
                <c:Pila Spacing="12">
                    <TextBlock Text="1. Elige donde guardar el respaldo" FontWeight="SemiBold" FontSize="15" />
                    <c:Pila Orientation="Horizontal" Spacing="10">
                        <Button x:Name="BtnCarpeta" Content="Elegir carpeta..." Click="Carpeta_Click" />
                        <TextBlock x:Name="TxtDestino" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextFillColorSecondaryBrush}" Text="Sin carpeta elegida." />
                    </c:Pila>
                </c:Pila>
            </Border>

            <Button x:Name="BtnRespaldar" HorizontalAlignment="Stretch" Height="50"
                    Style="{StaticResource AccentButtonStyle}" Click="Respaldar_Click" IsEnabled="False">
                <c:Pila Orientation="Horizontal" Spacing="10">
                    <c:FontIcon Glyph="&#xE8C8;" /><TextBlock Text="Hacer respaldo ahora" />
                </c:Pila>
            </Button>

            <c:InfoBar x:Name="Estado" IsOpen="False" IsClosable="True" Severity="Informational" />
        </c:Pila>
    </ScrollViewer>
</c:PaginaBase>
