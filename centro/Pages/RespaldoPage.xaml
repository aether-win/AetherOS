<?xml version="1.0" encoding="utf-8"?>
<c:PaginaBase
    x:Class="CentroAether.Pages.RespaldoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CentroAether.Controles">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <c:Pila Padding="36,30,36,36" Spacing="8" MaxWidth="1000">
            <c:Encabezado Glyph="&#xE8C8;" ColorIcono="#F2B33D" Titulo="Respaldo" Subtitulo="Copia tus carpetas y archivos importantes a otra carpeta o disco, a mano o cada día." />
            <c:InfoBar x:Name="Estado" IsOpen="False" IsClosable="True" Severity="Informational" Margin="0,0,0,4" />

            <TextBlock Text="1. Qué respaldar" Style="{StaticResource SeccionTextBlockStyle}" />
            <c:FilaAjuste Glyph="&#xE8B7;" Titulo="Carpetas y archivos"
                          Descripcion="Elige lo que quieres proteger (documentos, Excel del trabajo, fotos…).">
                <c:Pila Orientation="Horizontal" Spacing="8">
                    <Button Content="Agregar carpeta…" Click="AgregarCarpeta_Click" />
                    <Button Content="Agregar archivos…" Click="AgregarArchivos_Click" />
                </c:Pila>
            </c:FilaAjuste>
            <StackPanel x:Name="PanelOrigenes" />

            <TextBlock Text="2. Dónde guardarlo" Style="{StaticResource SeccionTextBlockStyle}" />
            <c:FilaAjuste x:Name="FilaDestino" Glyph="&#xE958;" Titulo="Destino del respaldo"
                          Descripcion="Sin carpeta elegida.">
                <Button Content="Elegir carpeta…" Click="Destino_Click" />
            </c:FilaAjuste>
            <c:FilaAjuste Glyph="&#xE81C;" Titulo="Versiones que se guardan"
                          Descripcion="Cada respaldo queda en su propia carpeta con fecha; las más viejas se borran solas.">
                <ComboBox x:Name="CmbVersiones" Width="110" SelectionChanged="Opcion_Changed" />
            </c:FilaAjuste>

            <TextBlock Text="3. Cuándo" Style="{StaticResource SeccionTextBlockStyle}" />
            <c:FilaAjuste Glyph="&#xE823;" Titulo="Respaldo automático diario"
                          Descripcion="Se hace solo a la hora elegida (con la sesión iniciada). Si falla, Aether te avisa.">
                <c:Pila Orientation="Horizontal" Spacing="10">
                    <TextBox x:Name="TxtHora" Width="80" Tag="20:00" LostFocus="Hora_LostFocus" />
                    <c:ToggleSwitch x:Name="TglDiario" Toggled="Diario_Toggled" />
                </c:Pila>
            </c:FilaAjuste>

            <TextBlock Text="4. Respaldar" Style="{StaticResource SeccionTextBlockStyle}" />
            <c:FilaAjuste x:Name="FilaUltimo" Glyph="&#xE898;" Titulo="Hacer respaldo ahora"
                          Descripcion="Todavía no hay respaldos.">
                <c:Pila Orientation="Horizontal" Spacing="8">
                    <Button x:Name="BtnAbrir" Content="Abrir respaldos" Click="Abrir_Click" />
                    <Button x:Name="BtnRespaldar" Content="Respaldar" Style="{StaticResource AccentButtonStyle}" Click="Respaldar_Click" />
                </c:Pila>
            </c:FilaAjuste>
        </c:Pila>
    </ScrollViewer>
</c:PaginaBase>
