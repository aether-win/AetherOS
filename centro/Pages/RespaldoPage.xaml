<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CentroAether.Pages.RespaldoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="32,24,32,24">
        <StackPanel Spacing="18" MaxWidth="900" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon Glyph="&#xE8C8;" FontSize="28" />
                <StackPanel>
                    <TextBlock Text="Respaldo" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="Copia tus archivos importantes a una carpeta o disco."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="18">
                <StackPanel Spacing="12">
                    <TextBlock Text="1. Elige donde guardar el respaldo" FontWeight="SemiBold" FontSize="15" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="BtnCarpeta" Content="Elegir carpeta..." Click="Carpeta_Click" />
                        <TextBlock x:Name="TxtDestino" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Sin carpeta elegida." />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Button x:Name="BtnRespaldar" HorizontalAlignment="Stretch" Height="50"
                    Style="{StaticResource AccentButtonStyle}" Click="Respaldar_Click" IsEnabled="False">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE8C8;" /><TextBlock Text="Hacer respaldo ahora" />
                </StackPanel>
            </Button>

            <InfoBar x:Name="Estado" IsOpen="False" IsClosable="True" Severity="Informational" />
        </StackPanel>
    </ScrollViewer>
</Page>
