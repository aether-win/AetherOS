<?xml version="1.0" encoding="utf-8"?>
<c:PaginaBase
    x:Class="CentroAether.Pages.CompatibilidadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CentroAether.Controles">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <c:Pila Padding="32,28,32,28" Spacing="14" MaxWidth="820" HorizontalAlignment="Left">

            <c:Pila Spacing="2">
                <TextBlock Text="Compatibilidad" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Cómo se comportan las apps y funciones de Windows con los ajustes de Aether."
                           Foreground="{StaticResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </c:Pila>

            <c:Pila x:Name="Contenedor" Spacing="10" />
        </c:Pila>
    </ScrollViewer>
</c:PaginaBase>
