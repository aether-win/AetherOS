<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CentroAether.Pages.CompatibilidadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="32,28,32,28" Spacing="14" MaxWidth="820" HorizontalAlignment="Left">

            <StackPanel Spacing="2">
                <TextBlock Text="Compatibilidad" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Cómo se comportan las apps y funciones de Windows con los ajustes de Aether."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel x:Name="Contenedor" Spacing="10" />
        </StackPanel>
    </ScrollViewer>
</Page>
