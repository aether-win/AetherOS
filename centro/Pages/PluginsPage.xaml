<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CentroAether.Pages.PluginsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="32,28,32,28" Spacing="16" MaxWidth="760" HorizontalAlignment="Left">

            <StackPanel Spacing="2">
                <TextBlock Text="Plugins" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Extensiones que amplían el Centro. Cada plugin es un archivo .json en tu carpeta de plugins."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="BtnCarpeta" Click="Carpeta_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B7;" FontSize="16" />
                        <TextBlock Text="Abrir carpeta de plugins" />
                    </StackPanel>
                </Button>
                <Button x:Name="BtnRefrescar" Click="Refrescar_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="16" />
                        <TextBlock Text="Actualizar" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <InfoBar x:Name="Estado" IsOpen="False" IsClosable="True" Severity="Informational" />

            <StackPanel x:Name="Contenedor" Spacing="10" />

            <Border x:Name="Vacio" Visibility="Collapsed"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="18">
                <StackPanel Spacing="8">
                    <TextBlock Text="Aún no hay plugins" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap" FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Para crear uno, coloca un archivo .json en la carpeta de plugins con este formato:" />
                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="12">
                        <TextBlock x:Name="TxtEjemplo" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
