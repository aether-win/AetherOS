<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CentroAether.Pages.PerfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="32,28,32,28" Spacing="18" MaxWidth="760" HorizontalAlignment="Left">

            <StackPanel Spacing="2">
                <TextBlock Text="Perfiles" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Asocia una app o juego a un modo. La aplicación automática al abrirlo llegará con Background Intelligence."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Alta -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="18">
                <StackPanel Spacing="12">
                    <TextBlock Text="Nuevo perfil" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtApp" Grid.Column="0" PlaceholderText="Nombre de la app o juego" />
                        <ComboBox x:Name="CmbModo" Grid.Column="1" MinWidth="130" SelectedIndex="0">
                            <ComboBoxItem Content="Gaming" />
                            <ComboBoxItem Content="Trabajo" />
                            <ComboBoxItem Content="Bateria" />
                        </ComboBox>
                        <Button x:Name="BtnAgregar" Grid.Column="2" Content="Agregar"
                                Style="{StaticResource AccentButtonStyle}" Click="Agregar_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <InfoBar x:Name="Estado" IsOpen="False" IsClosable="True" Severity="Informational" />

            <TextBlock Text="Perfiles guardados" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <StackPanel x:Name="Contenedor" Spacing="10" />
            <TextBlock x:Name="TxtVacio" Text="Aún no hay perfiles. Agrega el primero arriba."
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</Page>
