<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CentroAether.Pages.PerfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="32,28,32,28" Spacing="18" MaxWidth="760" HorizontalAlignment="Left">

            <StackPanel Spacing="2">
                <TextBlock Text="Perfiles" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Asocia una app o juego a un modo. Con el segundo plano activado, el modo se aplica solo al abrir la app."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Background Intelligence -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="18,12,18,12">
                <Grid>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Aplicar perfiles automáticamente" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Vigila los procesos y aplica el modo al abrir una app con perfil (no revierte al cerrar)."
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch x:Name="TglInteligencia" HorizontalAlignment="Right"
                                  Toggled="Inteligencia_Toggled" />
                </Grid>
            </Border>

            <!-- Alta -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="18">
                <StackPanel Spacing="12">
                    <TextBlock Text="Nuevo perfil" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBox x:Name="TxtApp" PlaceholderText="Nombre de la app o juego" />
                    <TextBox x:Name="TxtProceso" PlaceholderText="Proceso para autodetección (ej. cs2.exe)" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="CmbModo" Grid.Column="0" Header="Modo" HorizontalAlignment="Stretch" SelectedIndex="0">
                            <ComboBoxItem Content="Gaming" />
                            <ComboBoxItem Content="Trabajo" />
                            <ComboBoxItem Content="Bateria" />
                        </ComboBox>
                        <ComboBox x:Name="CmbMando" Grid.Column="1" Header="Mando virtual" HorizontalAlignment="Stretch" SelectedIndex="0">
                            <ComboBoxItem Content="Ninguno" />
                            <ComboBoxItem Content="Xbox 360" />
                            <ComboBoxItem Content="DualShock 4" />
                        </ComboBox>
                    </Grid>
                    <Button x:Name="BtnAgregar" Content="Agregar" HorizontalAlignment="Right"
                            Style="{StaticResource AccentButtonStyle}" Click="Agregar_Click" />
                </StackPanel>
            </Border>

            <InfoBar x:Name="Estado" IsOpen="False" IsClosable="True" Severity="Informational" />

            <TextBlock Text="Perfiles guardados" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <StackPanel x:Name="Contenedor" Spacing="10" />
            <TextBlock x:Name="TxtVacio" Text="Aún no hay perfiles. Agrega el primero arriba."
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</Page>
