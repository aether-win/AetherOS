<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CentroAether.Pages.PlaceholderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="32,24,32,24">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="460">
            <FontIcon Glyph="&#xE822;" FontSize="40" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock x:Name="TxtTitulo" Text="Seccion" Style="{StaticResource TitleTextBlockStyle}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Esta seccion se esta construyendo en el nuevo Centro Aether."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" TextAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
