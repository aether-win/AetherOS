<Window x:Class="CentroAether.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:CentroAether.Controles"
        Title="Centro Aether"
        Width="1220" Height="820" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/aether.ico"
        Background="{StaticResource FondoVentanaBrush}"
        Foreground="{StaticResource TextFillColorPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="14"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- Elemento del menú lateral -->
        <Style x:Key="ItemMenu" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#E6EEF8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="10,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" Background="Transparent" CornerRadius="8" Height="40">
                            <Grid>
                                <Border x:Name="Marca" Width="3" Height="18" CornerRadius="2" Background="#4FC3F7"
                                        HorizontalAlignment="Left" Visibility="Collapsed" />
                                <ContentPresenter Margin="14,0,8,0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#17304F" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1B3A63" />
                                <Setter TargetName="Marca" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Encabezado de categoría (no se puede seleccionar) -->
        <Style x:Key="EncabezadoMenu" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Foreground" Value="#6F87A3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter Margin="24,16,8,6" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="264" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Menú lateral -->
        <Border Grid.Column="0" BorderBrush="{StaticResource LineaBrush}" BorderThickness="0,0,1,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0E2140" Offset="0" />
                    <GradientStop Color="#0B1A2E" Offset="0.35" />
                    <GradientStop Color="#0A1628" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel>
                <!-- Marca -->
                <Grid DockPanel.Dock="Top" Margin="22,22,16,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" CornerRadius="12" Margin="0,0,12,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#4FC3F7" Offset="0" />
                                <GradientStop Color="#2F8CFF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Image Source="Assets/aether.ico" Width="28" Height="28" />
                    </Border>
                    <c:Pila Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Aether" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="Centro de control" FontSize="12" Foreground="{StaticResource TextFillColorSecondaryBrush}" />
                    </c:Pila>
                </Grid>

                <!-- Pie: modo actual -->
                <Border DockPanel.Dock="Bottom" Margin="14,8,14,16" Padding="14,12" CornerRadius="10"
                        Background="#0F2036" BorderBrush="#1C3756" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="PuntoModo" Width="10" Height="10" Fill="#6F87A3" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <c:Pila Grid.Column="1">
                            <TextBlock Text="Modo actual" FontSize="11.5" Foreground="{StaticResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="TxtModoMenu" Text="…" FontSize="14" FontWeight="SemiBold" />
                        </c:Pila>
                    </Grid>
                </Border>

                <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         SelectionChanged="Nav_SelectionChanged" />
            </DockPanel>
        </Border>

        <!-- Contenido de la sección elegida -->
        <ContentControl x:Name="Contenido" Grid.Column="1" Focusable="False" />
    </Grid>
</Window>
