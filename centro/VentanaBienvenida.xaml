<Window x:Class="CentroAether.VentanaBienvenida"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bienvenido a Aether OS" Width="980" Height="640" MinWidth="860" MinHeight="580"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="{DynamicResource FondoVentanaBrush}"
        Foreground="{StaticResource TextFillColorPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" UseLayoutRounding="True">

    <Window.Resources>
        <!-- Tarjeta seleccionable grande (RadioButton): icono, título y descripción -->
        <Style x:Key="TarjetaOpcion" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#E6EEF8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Width" Value="196" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Caja" CornerRadius="14" Padding="16,16,16,14" BorderThickness="1.5"
                                BorderBrush="#2A4466" Background="#14223A">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Border Width="42" Height="42" CornerRadius="11" HorizontalAlignment="Left"
                                            Background="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}">
                                        <TextBlock Text="{Binding Uid, RelativeSource={RelativeSource TemplatedParent}}"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20"
                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Border x:Name="Marca" Width="22" Height="22" CornerRadius="11" Background="#2F8CFF"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed">
                                        <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                                <ContentPresenter />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Caja" Property="Background" Value="#1A2C48" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Caja" Property="BorderBrush" Value="#2F8CFF" />
                                <Setter TargetName="Caja" Property="Background" Value="#16305A" />
                                <Setter TargetName="Marca" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Caja" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#2F8CFF" BlurRadius="22" ShadowDepth="0" Opacity="0.55" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TituloTarjeta" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="TextoTarjeta" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AFC0D4" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style x:Key="PasoTitulo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="PasoSub" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AFC0D4" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,22" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Panel izquierdo: marca y pasos -->
        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0B2A57" Offset="0" />
                    <GradientStop Color="#0A1830" Offset="0.6" />
                    <GradientStop Color="#071121" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel Margin="28,30,24,26">
                <StackPanel DockPanel.Dock="Top">
                    <Border Width="58" Height="58" CornerRadius="16" HorizontalAlignment="Left">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#4FC3F7" Offset="0" />
                                <GradientStop Color="#2F6BFF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Image Source="/Assets/aether.ico" Width="36" Height="36" />
                    </Border>
                    <TextBlock Text="Aether OS" FontSize="24" FontWeight="SemiBold" Margin="0,16,0,0" />
                    <TextBlock Text="Vamos a dejarlo a tu manera." Foreground="#AFC0D4" Margin="0,4,0,30" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Foreground="#6F87A3" FontSize="12" TextWrapping="Wrap"
                           Text="Todo se puede cambiar después en Aether Toolbox." />
                <StackPanel x:Name="ListaPasos" />
            </DockPanel>
        </Border>

        <!-- Contenido del paso -->
        <DockPanel Grid.Column="1" Margin="40,34,40,26">
            <Grid DockPanel.Dock="Bottom" Margin="0,18,0,0">
                <TextBlock x:Name="TxtResultado" Foreground="#4FC3F7" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,300,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnSaltar" Content="Ahora no" Padding="18,9" Click="Saltar_Click" />
                    <Button x:Name="BtnAtras" Content="Atrás" Padding="18,9" Margin="10,0,0,0" Click="Atras_Click" />
                    <Button x:Name="BtnListo" Content="Siguiente" Padding="24,9" Margin="10,0,0,0"
                            Style="{StaticResource AccentButtonStyle}" Click="Siguiente_Click" />
                </StackPanel>
            </Grid>

            <Grid>
                <!-- 1. Modo -->
                <StackPanel x:Name="Paso1">
                    <TextBlock Style="{StaticResource PasoTitulo}" Text="¿Cómo vas a usar la laptop?" />
                    <TextBlock Style="{StaticResource PasoSub}" Text="El modo ajusta energía, ventilador y rendimiento. Lo cambias cuando quieras con Ctrl+Alt+T / G / B." />
                    <WrapPanel>
                        <RadioButton x:Name="RbTrabajo" GroupName="Modo" IsChecked="True" Style="{StaticResource TarjetaOpcion}" Uid="&#xE821;" Tag="#2F8CFF">
                            <StackPanel><TextBlock Style="{StaticResource TituloTarjeta}" Text="Trabajo" /><TextBlock Style="{StaticResource TextoTarjeta}" Text="Equilibrado y silencioso. Office, red y carpetas al día." /></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="RbGaming" GroupName="Modo" Style="{StaticResource TarjetaOpcion}" Uid="&#xE7FC;" Tag="#7C4DFF">
                            <StackPanel><TextBlock Style="{StaticResource TituloTarjeta}" Text="Gaming" /><TextBlock Style="{StaticResource TextoTarjeta}" Text="Máximo rendimiento con el cargador conectado." /></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="RbBateria" GroupName="Modo" Style="{StaticResource TarjetaOpcion}" Uid="&#xE83F;" Tag="#22A06B">
                            <StackPanel><TextBlock Style="{StaticResource TituloTarjeta}" Text="Batería" /><TextBlock Style="{StaticResource TextoTarjeta}" Text="Dura más lejos del enchufe." /></StackPanel>
                        </RadioButton>
                    </WrapPanel>
                    <CheckBox x:Name="ChkAuto" Margin="0,8,0,0" IsChecked="True"
                              Content="Cambiar solo a Modo Batería al llegar al 30 % sin cargador" />
                </StackPanel>

                <!-- 2. Apariencia -->
                <ScrollViewer x:Name="Paso2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PasoTitulo}" Text="Apariencia" />
                        <TextBlock Style="{StaticResource PasoSub}" Text="Tema de Windows y estilo Wind-Aether (Windhawk)." />
                        <WrapPanel>
                            <RadioButton x:Name="RbOscuro" GroupName="Tema" IsChecked="True" Style="{StaticResource TarjetaOpcion}" Uid="&#xE708;" Tag="#1E2A44">
                                <StackPanel><TextBlock Style="{StaticResource TituloTarjeta}" Text="Oscuro" /><TextBlock Style="{StaticResource TextoTarjeta}" Text="Recomendado. Descansa la vista." /></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="RbClaro" GroupName="Tema" Style="{StaticResource TarjetaOpcion}" Uid="&#xE706;" Tag="#E0A526">
                                <StackPanel><TextBlock Style="{StaticResource TituloTarjeta}" Text="Claro" /><TextBlock Style="{StaticResource TextoTarjeta}" Text="Windows en modo claro." /></StackPanel>
                            </RadioButton>
                        </WrapPanel>
                        <TextBlock Text="Wind-Aether" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,10" Foreground="#4FC3F7" />
                        <WrapPanel>
                            <RadioButton x:Name="RbGlass" GroupName="Wind" Style="{StaticResource TarjetaOpcion}" Uid="&#xE771;" Tag="#00A3D9">
                                <StackPanel><TextBlock Style="{StaticResource TituloTarjeta}" Text="Aether Glass" /><TextBlock Style="{StaticResource TextoTarjeta}" Text="Barra, menús y ventanas translúcidas." /></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="RbLimpio" GroupName="Wind" Style="{StaticResource TarjetaOpcion}" Uid="&#xE790;" Tag="#5468FF">
                                <StackPanel><TextBlock Style="{StaticResource TituloTarjeta}" Text="Aether Limpio" /><TextBlock Style="{StaticResource TextoTarjeta}" Text="Sobrio y ordenado, sin transparencias." /></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="RbNinguno" GroupName="Wind" IsChecked="True" Style="{StaticResource TarjetaOpcion}" Uid="&#xE711;" Tag="#3A4A63">
                                <StackPanel><TextBlock Style="{StaticResource TituloTarjeta}" Text="Ninguno" /><TextBlock Style="{StaticResource TextoTarjeta}" Text="Windows tal cual." /></StackPanel>
                            </RadioButton>
                        </WrapPanel>
                        <TextBlock x:Name="TxtWindNota" Foreground="#AFC0D4" TextWrapping="Wrap" />
                        <Button x:Name="BtnAbrirWindhawk" Content="Abrir Windhawk" HorizontalAlignment="Left"
                                Margin="0,8,0,0" Padding="14,7" Visibility="Collapsed" Click="AbrirWindhawk_Click" />
                    </StackPanel>
                </ScrollViewer>

                <!-- 3. Trabajo -->
                <StackPanel x:Name="Paso3" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PasoTitulo}" Text="Tu red de trabajo" />
                    <TextBlock Style="{StaticResource PasoSub}" Text="Opcional. La carpeta de la otra PC queda fija como unidad Z: y lista para las macros de Excel." />
                    <Border Background="#14223A" BorderBrush="#2A4466" BorderThickness="1" CornerRadius="14" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Carpeta de red" FontWeight="SemiBold" />
                            <TextBlock Foreground="#AFC0D4" FontSize="12.5" Margin="0,4,0,10" Text="Ejemplo: \\192.168.1.10\SISTEMA EF RED" />
                            <TextBox x:Name="TxtRuta" Tag="\\IP-de-la-otra-PC\Carpeta" />
                        </StackPanel>
                    </Border>
                    <CheckBox x:Name="ChkRespaldo" Margin="0,18,0,0" Content="Abrir Aether Toolbox en Respaldo al terminar" />
                </StackPanel>

                <!-- 4. Resumen -->
                <StackPanel x:Name="Paso4" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PasoTitulo}" Text="Todo listo" />
                    <TextBlock Style="{StaticResource PasoSub}" Text="Esto es lo que se va a aplicar:" />
                    <Border Background="#14223A" BorderBrush="#2A4466" BorderThickness="1" CornerRadius="14" Padding="22,18">
                        <TextBlock x:Name="TxtResumen" LineHeight="26" TextWrapping="Wrap" />
                    </Border>
                    <TextBlock Foreground="#6F87A3" FontSize="12.5" TextWrapping="Wrap" Margin="0,14,0,0"
                               Text="El estilo de Wind-Aether se instala en segundo plano (Windhawk prepara cada mod); te aviso cuando esté." />
                </StackPanel>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
