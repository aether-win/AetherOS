<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Aether Toolbox (antes "Centro Aether") en WPF (.NET 8). Antes era WinUI 3, pero WinUI 3 sin empaquetar no
    arranca en la laptop de Daniel (combase 0x802B000A). Igual que Aether Transfer, se
    publica self-contained en un solo .exe que abre sin instalar ningún runtime.
    La versión de Windows en el TargetFramework es para Windows.Gaming.Input (mandos).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- Solo para el ícono de la bandeja (NotifyIcon); el menú es WPF oscuro. -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>CentroAether</RootNamespace>
    <AssemblyName>AetherToolbox</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\aether.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>3.0.0</Version>
    <Product>Aether Toolbox</Product>
    <AssemblyTitle>Aether Toolbox</AssemblyTitle>
    <Company>Aether OS</Company>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nefarius.ViGEm.Client" Version="1.21.256" />
    <PackageReference Include="HidSharp" Version="2.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\aether.ico" />
  </ItemGroup>

</Project>
