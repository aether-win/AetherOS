<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CentroAether.VentanaOverlayModo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Raiz" Opacity="0">
        <Grid.Resources>
            <Storyboard x:Key="FadeIn">
                <DoubleAnimation Storyboard.TargetName="Raiz"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0" To="1" Duration="0:0:0.28" />
            </Storyboard>
            <Storyboard x:Key="FadeOut">
                <DoubleAnimation Storyboard.TargetName="Raiz"
                                 Storyboard.TargetProperty="Opacity"
                                 From="1" To="0" Duration="0:0:0.40" />
            </Storyboard>
        </Grid.Resources>

        <Border x:Name="Marco" CornerRadius="0" Background="#F01B1B1F" BorderThickness="2">
            <Grid Padding="26,0,26,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="CajaIcono" Grid.Column="0" Width="84" Height="84" CornerRadius="16"
                        VerticalAlignment="Center">
                    <FontIcon x:Name="Icono" Glyph="&#xE7FC;" FontSize="42" Foreground="White" />
                </Border>

                <StackPanel Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center" Spacing="6">
                    <TextBlock x:Name="TxtTitulo" Text="MODO" FontSize="24" FontWeight="Bold"
                               Foreground="White" />
                    <TextBlock x:Name="TxtSub" Text="" FontSize="14" Foreground="#C8FFFFFF" />
                    <ProgressBar x:Name="Barra" IsIndeterminate="True" Margin="0,8,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="Franja" Height="4" VerticalAlignment="Top" />
    </Grid>
</Window>
