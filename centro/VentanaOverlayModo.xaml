<Window x:Class="CentroAether.VentanaOverlayModo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:CentroAether.Controles"
        Width="560" Height="280"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        Focusable="False" IsHitTestVisible="False"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        Foreground="White"
        UseLayoutRounding="True">

    <!-- Raíz con margen para que quepa el resplandor; se anima con zoom + fundido -->
    <Grid x:Name="Raiz" Opacity="0" Margin="30" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="Escala" ScaleX="0.9" ScaleY="0.9" />
        </Grid.RenderTransform>

        <!-- Resplandor del color del modo (detrás de la tarjeta, no difumina el texto) -->
        <Border x:Name="Resplandor" CornerRadius="26" Margin="10" Opacity="0.55">
            <Border.Effect>
                <BlurEffect Radius="34" />
            </Border.Effect>
        </Border>

        <!-- Tarjeta -->
        <Border x:Name="Tarjeta" CornerRadius="22" BorderThickness="1.5" ClipToBounds="True">
            <Grid>
                <!-- Brillo suave en la esquina -->
                <Ellipse x:Name="Brillo" Width="260" Height="260" HorizontalAlignment="Left" VerticalAlignment="Top"
                         Margin="-90,-120,0,0" Opacity="0.35">
                    <Ellipse.Effect>
                        <BlurEffect Radius="60" />
                    </Ellipse.Effect>
                </Ellipse>

                <Grid Margin="30,0,32,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Ícono -->
                    <Border x:Name="CajaIcono" Width="96" Height="96" CornerRadius="26" VerticalAlignment="Center">
                        <c:FontIcon x:Name="Icono" Glyph="&#xE7FC;" FontSize="46" Foreground="White"
                                    HorizontalAlignment="Center" />
                    </Border>

                    <c:Pila Grid.Column="1" Margin="26,0,0,0" VerticalAlignment="Center" Spacing="4">
                        <TextBlock x:Name="TxtMarca" Text="AETHER OS" FontSize="11.5" FontWeight="SemiBold" />
                        <TextBlock x:Name="TxtTitulo" Text="Modo" FontSize="30" FontWeight="Bold" Foreground="White" />
                        <TextBlock x:Name="TxtSub" Text="" FontSize="14.5" Foreground="#D0FFFFFF" TextWrapping="Wrap" />
                        <!-- Barra que se llena mientras el aviso está en pantalla -->
                        <Grid Margin="0,14,0,0" Height="6">
                            <Border CornerRadius="3" Background="#26FFFFFF" />
                            <Border x:Name="Barra" CornerRadius="3" HorizontalAlignment="Left" Width="0" />
                        </Grid>
                    </c:Pila>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
