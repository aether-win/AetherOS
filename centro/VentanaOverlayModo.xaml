<Window x:Class="CentroAether.VentanaOverlayModo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:CentroAether.Controles"
        Width="470" Height="260"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        Focusable="False"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Foreground="White">

    <Grid x:Name="Raiz" Opacity="0">
        <Border x:Name="Marco" Background="#F01B1B1F" BorderThickness="2">
            <Grid Margin="26,0,26,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="CajaIcono" Grid.Column="0" Width="84" Height="84" CornerRadius="16"
                        VerticalAlignment="Center">
                    <c:FontIcon x:Name="Icono" Glyph="&#xE7FC;" FontSize="42" Foreground="White"
                                HorizontalAlignment="Center" />
                </Border>

                <c:Pila Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center" Spacing="6">
                    <TextBlock x:Name="TxtTitulo" Text="MODO" FontSize="24" FontWeight="Bold" Foreground="White" />
                    <TextBlock x:Name="TxtSub" Text="" FontSize="14" Foreground="#C8FFFFFF" TextWrapping="Wrap" />
                    <!-- Barra "cargando" que se desliza (sustituye al ProgressBar indeterminado de WinUI) -->
                    <Canvas x:Name="Carril" Height="4" Margin="0,8,0,0" ClipToBounds="True" Background="#33FFFFFF">
                        <Border x:Name="Barra" Width="110" Height="4" CornerRadius="2" Canvas.Left="-110" />
                    </Canvas>
                </c:Pila>
            </Grid>
        </Border>

        <Border x:Name="Franja" Height="4" VerticalAlignment="Top" />
    </Grid>
</Window>
