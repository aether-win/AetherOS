<Application x:Class="CentroAether.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CentroAether.Controles"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>

            <!-- ====== Colores base (tema oscuro Aether, igual que Aether Transfer) ====== -->
            <SolidColorBrush x:Key="FondoVentanaBrush"  Color="#0A1524" />
            <SolidColorBrush x:Key="FondoSolidoBrush"   Color="#0A1524" />
            <SolidColorBrush x:Key="TarjetaFondoBrush"  Color="#0F2036" />
            <LinearGradientBrush x:Key="MenuFondoBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#0E2140" Offset="0" />
                <GradientStop Color="#0B1A2E" Offset="0.35" />
                <GradientStop Color="#0A1628" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="FondoMenuBrush"     Color="#0C1B30" />
            <SolidColorBrush x:Key="CampoBrush"         Color="#0A1726" />
            <SolidColorBrush x:Key="LineaBrush"         Color="#1E3A5C" />
            <SolidColorBrush x:Key="HoverBrush"         Color="#17304F" />
            <SolidColorBrush x:Key="SeleccionBrush"     Color="#1B3A63" />
            <SolidColorBrush x:Key="InfoBarFondoBrush"  Color="#10233B" />

            <!-- Nombres de los recursos de WinUI que usaban las páginas -->
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush"          Color="#E6EEF8" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush"        Color="#9DB2CC" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush"         Color="#6F87A3" />
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush"         Color="#0B1A2E" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#0F2036" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush"        Color="#1C3756" />
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush"        Color="#2F8CFF" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush"  Color="#FFFFFF" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush"    Color="#4FC3F7" />
            <SolidColorBrush x:Key="SystemFillColorSuccessBrush"        Color="#3FBF7F" />
            <SolidColorBrush x:Key="SystemFillColorCautionBrush"        Color="#F2B33D" />
            <SolidColorBrush x:Key="SystemFillColorCriticalBrush"       Color="#F0565C" />
            <SolidColorBrush x:Key="SystemFillColorAttentionBrush"      Color="#4FC3F7" />
            <SolidColorBrush x:Key="SystemFillColorAttentionBackgroundBrush" Color="#163A5C" />

            <SolidColorBrush x:Key="IconoFondoBrush"     Color="#16304F" />
            <SolidColorBrush x:Key="TarjetaHoverBrush"   Color="#13294A" />

            <!-- ====== Diseño: tarjetas, filas de ajuste, mosaicos y títulos de sección ====== -->
            <Style x:Key="TarjetaStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource TarjetaFondoBrush}" />
                <Setter Property="BorderBrush" Value="#1C3756" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="20,18" />
            </Style>
            <Style x:Key="FilaAjusteStyle" TargetType="c:FilaAjuste">
                <Setter Property="Background" Value="{DynamicResource TarjetaFondoBrush}" />
                <Setter Property="BorderBrush" Value="#1C3756" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="16,14" />
                <Setter Property="MinHeight" Value="68" />
            </Style>
            <Style x:Key="SeccionTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#E6EEF8" />
                <Setter Property="Margin" Value="2,14,0,2" />
            </Style>
            <Style x:Key="MosaicoStyle" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource TarjetaFondoBrush}" />
                <Setter Property="BorderBrush" Value="#1C3756" />
                <Setter Property="Foreground" Value="#E6EEF8" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="18,16" />
                <Setter Property="Margin" Value="0,0,12,12" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="12"
                                    Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#13294A" />
                                    <Setter TargetName="b" Property="BorderBrush" Value="#2F8CFF" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="b" Property="Opacity" Value="0.85" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="b" Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ====== Estilos de texto (mismos nombres que en WinUI) ====== -->
            <Style x:Key="TitleTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="26" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="SubtitleTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="BodyTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="BodyStrongTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <!-- ====== Botón normal (oscuro) ====== -->
            <Style TargetType="Button">
                <Setter Property="Background" Value="#16304F" />
                <Setter Property="Foreground" Value="#E6EEF8" />
                <Setter Property="BorderBrush" Value="#24456B" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="14,7" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6"
                                    Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Opacity" Value="0.88" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="b" Property="Opacity" Value="0.75" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="b" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Botón de acento (azul Aether), como AccentButtonStyle de WinUI -->
            <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="#2F8CFF" />
                <Setter Property="BorderBrush" Value="#2F8CFF" />
                <Setter Property="Foreground" Value="#FFFFFF" />
            </Style>

            <!-- Botón plano (cerrar avisos, iconos) -->
            <Style x:Key="BotonPlanoStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="#9DB2CC" />
            </Style>

            <!-- ====== Interruptor (ToggleSwitch) ====== -->
            <Style x:Key="ToggleSwitchStyle" TargetType="c:ToggleSwitch">
                <Setter Property="Foreground" Value="#E6EEF8" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="c:ToggleSwitch">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <Border x:Name="Pista" Width="40" Height="20" CornerRadius="10" BorderThickness="1"
                                        BorderBrush="#6F87A3" Background="Transparent" VerticalAlignment="Center">
                                    <Ellipse x:Name="Bola" Width="12" Height="12" Fill="#9DB2CC"
                                             HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0" />
                                </Border>
                                <ContentPresenter x:Name="Texto" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Pista" Property="BorderBrush" Value="#9DB2CC" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Pista" Property="Background" Value="#2F8CFF" />
                                    <Setter TargetName="Pista" Property="BorderBrush" Value="#2F8CFF" />
                                    <Setter TargetName="Bola" Property="Fill" Value="#FFFFFF" />
                                    <Setter TargetName="Bola" Property="HorizontalAlignment" Value="Right" />
                                    <Setter TargetName="Bola" Property="Margin" Value="0,0,4,0" />
                                </Trigger>
                                <Trigger Property="Content" Value="{x:Null}">
                                    <Setter TargetName="Texto" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ====== Casilla (CheckBox) oscura ====== -->
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="#E6EEF8" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <Border x:Name="Caja" Width="18" Height="18" CornerRadius="4" BorderThickness="1"
                                        BorderBrush="#6F87A3" Background="#0A1726" VerticalAlignment="Center">
                                    <TextBlock x:Name="Marca" Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="11" Foreground="White" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Caja" Property="Background" Value="#2F8CFF" />
                                    <Setter TargetName="Caja" Property="BorderBrush" Value="#2F8CFF" />
                                    <Setter TargetName="Marca" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Caja" Property="BorderBrush" Value="#9DB2CC" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ====== Opción (RadioButton) oscura ====== -->
            <Style TargetType="RadioButton">
                <Setter Property="Foreground" Value="#E6EEF8" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Margin" Value="0,4,22,4" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <Grid Width="18" Height="18" VerticalAlignment="Center">
                                    <Ellipse x:Name="Aro" Stroke="#6F87A3" StrokeThickness="1.4" Fill="#0A1726" />
                                    <Ellipse x:Name="Punto" Width="8" Height="8" Fill="White" Visibility="Collapsed" />
                                </Grid>
                                <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Aro" Property="Fill" Value="#2F8CFF" />
                                    <Setter TargetName="Aro" Property="Stroke" Value="#2F8CFF" />
                                    <Setter TargetName="Punto" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Aro" Property="Stroke" Value="#9DB2CC" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ====== Cuadro de texto (Tag = texto de ayuda cuando está vacío) ====== -->
            <Style TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource CampoBrush}" />
                <Setter Property="Foreground" Value="#E6EEF8" />
                <Setter Property="BorderBrush" Value="{StaticResource LineaBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="CaretBrush" Value="#E6EEF8" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                <Grid>
                                    <TextBlock x:Name="Ayuda" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Foreground="#6F87A3"
                                               Margin="{TemplateBinding Padding}" Padding="2,0,0,0"
                                               VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
                                    <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter TargetName="Ayuda" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="b" Property="BorderBrush" Value="#2F8CFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ====== ComboBox totalmente oscuro ====== -->
            <Style TargetType="ComboBox">
                <Setter Property="Foreground" Value="#E6EEF8" />
                <Setter Property="Height" Value="32" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid TextElement.Foreground="#E6EEF8">
                                <ToggleButton Focusable="False" ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="#0A1726" BorderBrush="#1E3A5C" BorderThickness="1" CornerRadius="6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="24" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="1" Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9"
                                                               Foreground="#9DB2CC" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  Margin="10,0,28,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                                <Popup Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                    <Border Background="#0F2036" BorderBrush="#24456B" BorderThickness="1" CornerRadius="6" Margin="0,3,0,0"
                                            MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                                            <StackPanel IsItemsHost="True" Margin="3" />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="#E6EEF8" />
                <Setter Property="Padding" Value="9,6" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="b" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#2F8CFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ====== Barra de progreso ====== -->
            <Style TargetType="ProgressBar">
                <Setter Property="Height" Value="6" />
                <Setter Property="Foreground" Value="#2F8CFF" />
                <Setter Property="Background" Value="#1E3A5C" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid>
                                <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="3" />
                                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3"
                                        HorizontalAlignment="Left" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ====== ToolTip oscuro ====== -->
            <Style TargetType="ToolTip">
                <Setter Property="Foreground" Value="#E6EEF8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border Background="#0F2036" BorderBrush="#24456B" BorderThickness="1" CornerRadius="5" Padding="9,5">
                                <ContentPresenter />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ====== Barra de desplazamiento oscura ====== -->
            <Style x:Key="SbThumb" TargetType="Thumb">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border CornerRadius="4" Background="#2A4A6E" Margin="2" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="ScrollBar">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Width" Value="11" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource SbThumb}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                                    </Track.DecreaseRepeatButton>
                                </Track>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Orientation" Value="Horizontal">
                                    <Setter Property="Width" Value="Auto" />
                                    <Setter Property="Height" Value="11" />
                                    <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
