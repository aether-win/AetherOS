<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CentroAether.VentanaOverlayGaming"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Raiz" Opacity="0">
        <Grid.Resources>
            <Storyboard x:Key="FadeIn">
                <DoubleAnimation Storyboard.TargetName="Raiz"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0" To="1" Duration="0:0:0.28" />
            </Storyboard>
            <Storyboard x:Key="FadeOut">
                <DoubleAnimation Storyboard.TargetName="Raiz"
                                 Storyboard.TargetProperty="Opacity"
                                 From="1" To="0" Duration="0:0:0.40" />
            </Storyboard>
        </Grid.Resources>

        <!-- Fondo oscuro tipo overlay de juego -->
        <Border CornerRadius="0" Background="#F01B1B1F"
                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="2">
            <Grid Padding="26,0,26,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Icono -->
                <Border Grid.Column="0" Width="84" Height="84" CornerRadius="16"
                        VerticalAlignment="Center"
                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <FontIcon Glyph="&#xE7FC;" FontSize="42" Foreground="White" />
                </Border>

                <!-- Texto -->
                <StackPanel Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center" Spacing="6">
                    <TextBlock Text="MODO GAMING" FontSize="24" FontWeight="Bold"
                               Foreground="White" />
                    <TextBlock x:Name="TxtSub" Text="Máximo rendimiento activado"
                               FontSize="14" Foreground="#C8FFFFFF" />
                    <ProgressBar IsIndeterminate="True" Margin="0,8,0,0"
                                 Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Franja de acento superior -->
        <Border Height="4" VerticalAlignment="Top"
                Background="{ThemeResource AccentFillColorDefaultBrush}" />
    </Grid>
</Window>
