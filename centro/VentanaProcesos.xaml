<Window x:Class="CentroAether.VentanaProcesos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:CentroAether.Controles"
        Title="Elegir un programa abierto" Width="760" Height="560" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize"
        Background="{DynamicResource FondoVentanaBrush}"
        Foreground="{StaticResource TextFillColorPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="FilaProceso" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#E6EEF8" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" Background="Transparent" CornerRadius="8" Padding="12,9" Margin="0,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#17304F" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1B3A63" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <c:Encabezado Grid.Row="0" Glyph="&#xE71D;" ColorIcono="#7A5AF8" Titulo="Programas abiertos"
                      Subtitulo="Abre el juego o la app y elígelo aquí: Aether toma su nombre y su proceso." />

        <TextBox x:Name="TxtBuscar" Grid.Row="1" Margin="0,4,0,12" Tag="Buscar (por ejemplo: GTA)" TextChanged="Buscar_Changed" />

        <Border Grid.Row="2" Background="{DynamicResource TarjetaFondoBrush}" BorderBrush="#1C3756" BorderThickness="1" CornerRadius="12" Padding="6">
            <Grid>
                <ListBox x:Name="Lista" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource FilaProceso}"
                         MouseDoubleClick="Lista_DobleClic" SelectionChanged="Lista_Seleccion" />
                <TextBlock x:Name="TxtCargando" Text="Buscando programas…" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Foreground="{StaticResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="ChkTodos" Content="Mostrar también procesos sin ventana" VerticalAlignment="Center"
                      Foreground="{StaticResource TextFillColorSecondaryBrush}" Checked="Todos_Changed" Unchecked="Todos_Changed" />
            <c:Pila Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="Cancelar" IsCancel="True" />
                <Button x:Name="BtnElegir" Content="Elegir" Style="{StaticResource AccentButtonStyle}"
                        IsDefault="True" IsEnabled="False" Click="Elegir_Click" />
            </c:Pila>
        </Grid>
    </Grid>
</Window>
