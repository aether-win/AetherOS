<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="AetherTransfer.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Identidad Aether Transfer: azul eléctrico / cian -->
            <Color x:Key="AetherAzul">#1E6BFF</Color>
            <Color x:Key="AetherCian">#22D3EE</Color>
            <SolidColorBrush x:Key="AetherAzulBrush" Color="{StaticResource AetherAzul}" />
            <SolidColorBrush x:Key="AetherCianBrush" Color="{StaticResource AetherCian}" />

            <!-- Botón de barra de herramientas (icono sobre etiqueta) -->
            <Style x:Key="Herramienta" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="10,6,10,6" />
                <Setter Property="Foreground" Value="#E6EEF8" />
            </Style>

            <!-- Botón del rail de navegación -->
            <Style x:Key="Nav" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Padding" Value="10,8,10,8" />
                <Setter Property="Foreground" Value="#C7D6EC" />
            </Style>

            <!-- Botón pequeño de barra de explorador -->
            <Style x:Key="Mini" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="7,4,7,4" />
                <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="#C7D6EC" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
