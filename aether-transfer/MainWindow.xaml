<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AetherTransfer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Raiz" RequestedTheme="Dark" Background="#0A1524">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- BARRA DE HERRAMIENTAS -->
        <Grid Grid.Row="0" Background="#0C1B30" BorderBrush="#1E3A5C" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Padding="10,8,10,8" Spacing="4">
                <Button Background="Transparent" BorderThickness="0" Padding="10,6" Click="AdminSitios_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE774;" FontSize="18" Foreground="#22D3EE" />
                        <TextBlock Text="Sitios" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0" Foreground="#E6EEF8" />
                    </StackPanel>
                </Button>
                <Button Background="Transparent" BorderThickness="0" Padding="10,6" Click="Conectar_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE710;" FontSize="18" Foreground="#22D3EE" />
                        <TextBlock Text="Conectar" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0" Foreground="#E6EEF8" />
                    </StackPanel>
                </Button>
                <Button Background="Transparent" BorderThickness="0" Padding="10,6" Click="Desconectar_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE8CB;" FontSize="18" Foreground="#22D3EE" />
                        <TextBlock Text="Desconectar" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0" Foreground="#E6EEF8" />
                    </StackPanel>
                </Button>
                <Border Width="1" Background="#1E3A5C" Margin="4,2" />
                <Button Background="Transparent" BorderThickness="0" Padding="10,6" Click="Sincronizar_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE895;" FontSize="18" Foreground="#22D3EE" />
                        <TextBlock Text="Sincronizar" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0" Foreground="#E6EEF8" />
                    </StackPanel>
                </Button>
                <Button Background="Transparent" BorderThickness="0" Padding="10,6" Click="Config_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE713;" FontSize="18" Foreground="#22D3EE" />
                        <TextBlock Text="Configuración" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0" Foreground="#E6EEF8" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0" Spacing="8">
                <Image Source="Assets/aether-transfer.png" Width="26" Height="26" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="AETHER" FontWeight="Bold" FontSize="15" Foreground="#E6EEF8" />
                    <TextBlock Text="TRANSFER" FontSize="10" Foreground="#22D3EE" Margin="0,-3,0,0" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- CONEXIÓN RÁPIDA -->
        <Grid Grid.Row="1" Background="#0B1A2E" Padding="12,8" BorderBrush="#1E3A5C" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Servidor:" Foreground="#9DB2CC" VerticalAlignment="Center" />
                <TextBox x:Name="TxtHost" Text="192.168.1.10" Width="150" />
                <TextBlock Text="Usuario:" Foreground="#9DB2CC" VerticalAlignment="Center" Margin="6,0,0,0" />
                <TextBox x:Name="TxtUsuario" Text="anonymous" Width="120" />
                <TextBlock Text="Contraseña:" Foreground="#9DB2CC" VerticalAlignment="Center" Margin="6,0,0,0" />
                <PasswordBox x:Name="TxtPass" Width="120" />
                <TextBlock Text="Puerto:" Foreground="#9DB2CC" VerticalAlignment="Center" Margin="6,0,0,0" />
                <TextBox x:Name="TxtPuerto" Text="21" Width="60" />
                <Button x:Name="BtnConectar" Content="Conexión rápida" Background="#1E6BFF" Foreground="White" Margin="6,0,0,0" Click="Conectar_Click" />
            </StackPanel>
        </Grid>

        <!-- CUERPO -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Registro de actividad -->
            <Border Grid.Row="0" Height="92" Margin="10,10,10,6" CornerRadius="6"
                    Background="#0F2036" BorderBrush="#1E3A5C" BorderThickness="1">
                <ScrollViewer Padding="10,6">
                    <ItemsControl x:Name="LogLista">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" Foreground="#9DB2CC" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Explorador doble -->
            <Grid Grid.Row="1" Margin="10,0,10,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sitio local -->
                <Border Grid.Column="0" CornerRadius="6" Background="#0F2036" BorderBrush="#1E3A5C" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Padding="10,8,10,4">
                            <TextBlock Text="Sitio local:" Foreground="#9DB2CC" VerticalAlignment="Center" />
                            <TextBox x:Name="TxtLocalRuta" Width="240" IsReadOnly="True" />
                            <Button Content="&#xE74A;" FontFamily="Segoe Fluent Icons" Padding="7,4" Background="Transparent" BorderThickness="0" Foreground="#C7D6EC" Click="LocalSubir_Click" ToolTipService.ToolTip="Subir un nivel" />
                            <Button Content="&#xE72C;" FontFamily="Segoe Fluent Icons" Padding="7,4" Background="Transparent" BorderThickness="0" Foreground="#C7D6EC" Click="LocalActualizar_Click" ToolTipService.ToolTip="Actualizar" />
                        </StackPanel>
                        <Border Grid.Row="1" Height="1" Background="#1E3A5C" />
                        <ListView x:Name="LocalLista" Grid.Row="2" SelectionMode="Extended"
                                  DoubleTapped="LocalLista_DoubleTapped" RightTapped="Lista_RightTapped" Padding="4,2">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="86" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="{Binding Glyph}" FontSize="15" Foreground="#E0C060" />
                                            <TextBlock Text="{Binding Nombre}" FontSize="12.5" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding TamanoTexto}" FontSize="12" Foreground="#9DB2CC" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Tipo}" FontSize="12" Foreground="#9DB2CC" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding FechaTexto}" FontSize="12" Foreground="#9DB2CC" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                            <ListView.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Subir al servidor" Click="Subir_Click" />
                                    <MenuFlyoutItem Text="Nueva carpeta" Click="LocalNuevaCarpeta_Click" />
                                    <MenuFlyoutItem Text="Renombrar" Click="LocalRenombrar_Click" />
                                    <MenuFlyoutItem Text="Eliminar" Click="LocalEliminar_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Actualizar" Click="LocalActualizar_Click" />
                                </MenuFlyout>
                            </ListView.ContextFlyout>
                        </ListView>
                        <TextBlock x:Name="LocalInfo" Grid.Row="3" Text="" Foreground="#9DB2CC" FontSize="11.5" Padding="10,5" />
                    </Grid>
                </Border>

                <!-- Botones de transferencia -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                    <Button Click="Subir_Click" Width="34" Height="34" Background="#1E6BFF" ToolTipService.ToolTip="Subir al servidor">
                        <FontIcon Glyph="&#xE74A;" FontSize="16" Foreground="White" />
                    </Button>
                    <Button Click="Descargar_Click" Width="34" Height="34" Background="#122844" ToolTipService.ToolTip="Descargar al equipo">
                        <FontIcon Glyph="&#xE74B;" FontSize="16" Foreground="#22D3EE" />
                    </Button>
                </StackPanel>

                <!-- Sitio remoto -->
                <Border Grid.Column="2" CornerRadius="6" Background="#0F2036" BorderBrush="#1E3A5C" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Padding="10,8,10,4">
                            <TextBlock Text="Sitio remoto:" Foreground="#9DB2CC" VerticalAlignment="Center" />
                            <TextBox x:Name="TxtRemotoRuta" Width="220" IsReadOnly="True" />
                            <Button Content="&#xE74A;" FontFamily="Segoe Fluent Icons" Padding="7,4" Background="Transparent" BorderThickness="0" Foreground="#C7D6EC" Click="RemotoSubir_Click" ToolTipService.ToolTip="Subir un nivel" />
                            <Button Content="&#xE72C;" FontFamily="Segoe Fluent Icons" Padding="7,4" Background="Transparent" BorderThickness="0" Foreground="#C7D6EC" Click="RemotoActualizar_Click" ToolTipService.ToolTip="Actualizar" />
                        </StackPanel>
                        <Border Grid.Row="1" Height="1" Background="#1E3A5C" />
                        <ListView x:Name="RemotoLista" Grid.Row="2" SelectionMode="Extended"
                                  DoubleTapped="RemotoLista_DoubleTapped" RightTapped="Lista_RightTapped" Padding="4,2">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="86" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="{Binding Glyph}" FontSize="15" Foreground="#E0C060" />
                                            <TextBlock Text="{Binding Nombre}" FontSize="12.5" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding TamanoTexto}" FontSize="12" Foreground="#9DB2CC" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Tipo}" FontSize="12" Foreground="#9DB2CC" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding FechaTexto}" FontSize="12" Foreground="#9DB2CC" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                            <ListView.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Descargar al equipo" Click="Descargar_Click" />
                                    <MenuFlyoutItem Text="Nueva carpeta" Click="RemotoNuevaCarpeta_Click" />
                                    <MenuFlyoutItem Text="Renombrar" Click="RemotoRenombrar_Click" />
                                    <MenuFlyoutItem Text="Eliminar" Click="RemotoEliminar_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Actualizar" Click="RemotoActualizar_Click" />
                                </MenuFlyout>
                            </ListView.ContextFlyout>
                        </ListView>
                        <TextBlock x:Name="RemotoInfo" Grid.Row="3" Text="No conectado" Foreground="#9DB2CC" FontSize="11.5" Padding="10,5" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Cola de transferencias -->
            <Border Grid.Row="2" Height="150" Margin="10,0,10,8" CornerRadius="6"
                    Background="#0F2036" BorderBrush="#1E3A5C" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="18" Padding="12,8,12,6">
                        <TextBlock x:Name="TabCola" Text="Archivos en cola (0)" Foreground="#22D3EE" FontWeight="SemiBold" />
                        <TextBlock x:Name="TabFallidas" Text="Transferencias fallidas (0)" Foreground="#9DB2CC" />
                        <TextBlock x:Name="TabHechas" Text="Transferencias satisfactorias (0)" Foreground="#9DB2CC" />
                    </StackPanel>
                    <Border Grid.Row="1" Height="1" Background="#1E3A5C" />
                    <Grid Grid.Row="2">
                        <ListView x:Name="ColaLista" SelectionMode="None" Padding="0,2">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="30" Padding="12,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="140" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="{Binding DireccionIcono}" FontSize="13" Foreground="#22D3EE" />
                                            <TextBlock Text="{Binding Nombre}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding RutaRemota}" FontSize="11.5" Foreground="#9DB2CC" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding TamanoTexto}" FontSize="11.5" Foreground="#9DB2CC" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="1">
                                            <ProgressBar Value="{Binding Progreso, Mode=OneWay}" Maximum="100" Width="90" HorizontalAlignment="Left" Foreground="#1E6BFF" />
                                            <TextBlock Text="{Binding ProgresoTexto, Mode=OneWay}" FontSize="10.5" Foreground="#9DB2CC" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="4" Text="{Binding VelocidadTexto, Mode=OneWay}" FontSize="11.5" Foreground="#9DB2CC" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding EstadoTexto, Mode=OneWay}" FontSize="11.5" Foreground="#E6EEF8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Width="70" />
                                            <Button Click="Pausar_Click" Padding="4" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Pausar/Reanudar">
                                                <FontIcon Glyph="&#xE769;" FontSize="12" Foreground="#9DB2CC" />
                                            </Button>
                                            <Button Click="Cancelar_Click" Padding="4" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Cancelar/Quitar">
                                                <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="#9DB2CC" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="ColaVacia" Text="No hay transferencias en cola."
                                   Foreground="#9DB2CC" FontSize="12" Padding="12,10"
                                   VerticalAlignment="Top" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- BARRA DE ESTADO -->
        <Grid Grid.Row="3" Background="#0C1B30" Padding="12,5" BorderBrush="#1E3A5C" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Ellipse x:Name="EstadoPunto" Width="8" Height="8" Fill="#6B7B90" />
                <TextBlock x:Name="TxtEstado" Text="No conectado" Foreground="#9DB2CC" FontSize="12" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
