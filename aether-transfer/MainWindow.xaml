<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AetherTransfer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Grid x:Name="Raiz" RequestedTheme="Dark" Background="#0A1524">
        <Grid.Resources>
            <SolidColorBrush x:Key="Panel" Color="#0F2036" />
            <SolidColorBrush x:Key="PanelAlt" Color="#122844" />
            <SolidColorBrush x:Key="Linea" Color="#1E3A5C" />
            <SolidColorBrush x:Key="TxtPri" Color="#E6EEF8" />
            <SolidColorBrush x:Key="TxtSec" Color="#9DB2CC" />
            <SolidColorBrush x:Key="Acento" Color="#1E6BFF" />
            <SolidColorBrush x:Key="Cian" Color="#22D3EE" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- MENÚ -->
        <muxc:MenuBar Grid.Row="0" Background="#0C1B30">
            <muxc:MenuBarItem Title="Archivo">
                <MenuFlyoutItem Text="Administrador de sitios" />
                <MenuFlyoutItem Text="Nueva conexión" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Salir" />
            </muxc:MenuBarItem>
            <muxc:MenuBarItem Title="Edición">
                <MenuFlyoutItem Text="Copiar" />
                <MenuFlyoutItem Text="Pegar" />
                <MenuFlyoutItem Text="Preferencias" />
            </muxc:MenuBarItem>
            <muxc:MenuBarItem Title="Ver">
                <MenuFlyoutItem Text="Actualizar" />
                <MenuFlyoutItem Text="Mostrar archivos ocultos" />
            </muxc:MenuBarItem>
            <muxc:MenuBarItem Title="Transferencia">
                <MenuFlyoutItem Text="Cola de transferencias" />
                <MenuFlyoutItem Text="Límites de velocidad" />
            </muxc:MenuBarItem>
            <muxc:MenuBarItem Title="Servidor">
                <MenuFlyoutItem Text="Conectar" />
                <MenuFlyoutItem Text="Desconectar" />
                <MenuFlyoutItem Text="Información del servidor" />
            </muxc:MenuBarItem>
            <muxc:MenuBarItem Title="Marcadores">
                <MenuFlyoutItem Text="Añadir marcador" />
                <MenuFlyoutItem Text="Administrar marcadores" />
            </muxc:MenuBarItem>
            <muxc:MenuBarItem Title="Ayuda">
                <MenuFlyoutItem Text="Acerca de Aether Transfer" />
            </muxc:MenuBarItem>
        </muxc:MenuBar>

        <!-- BARRA DE HERRAMIENTAS -->
        <Grid Grid.Row="1" Background="#0C1B30" BorderBrush="{StaticResource Linea}" BorderThickness="0,1,0,1">
            <StackPanel Orientation="Horizontal" Padding="10,8,10,8" Spacing="4">
                <Button Style="{StaticResource Herramienta}">
                    <StackPanel HorizontalAlignment="Center"><FontIcon Glyph="&#xE774;" FontSize="18" Foreground="{StaticResource Cian}" /><TextBlock Text="Administrador de sitios" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0" /></StackPanel>
                </Button>
                <Button Style="{StaticResource Herramienta}">
                    <StackPanel HorizontalAlignment="Center"><FontIcon Glyph="&#xE710;" FontSize="18" Foreground="{StaticResource Cian}" /><TextBlock Text="Nueva conexión" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0" /></StackPanel>
                </Button>
                <Button Style="{StaticResource Herramienta}">
                    <StackPanel HorizontalAlignment="Center"><FontIcon Glyph="&#xE8CB;" FontSize="18" Foreground="{StaticResource Cian}" /><TextBlock Text="Desconectar" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0" /></StackPanel>
                </Button>
                <Border Width="1" Background="{StaticResource Linea}" Margin="4,2,4,2" />
                <Button Style="{StaticResource Herramienta}">
                    <StackPanel HorizontalAlignment="Center"><FontIcon Glyph="&#xE898;" FontSize="18" Foreground="{StaticResource Cian}" /><TextBlock Text="Transferencias" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0" /></StackPanel>
                </Button>
                <Button Style="{StaticResource Herramienta}">
                    <StackPanel HorizontalAlignment="Center"><FontIcon Glyph="&#xE895;" FontSize="18" Foreground="{StaticResource Cian}" /><TextBlock Text="Sincronizar" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0" /></StackPanel>
                </Button>
                <Button Style="{StaticResource Herramienta}">
                    <StackPanel HorizontalAlignment="Center"><FontIcon Glyph="&#xE734;" FontSize="18" Foreground="{StaticResource Cian}" /><TextBlock Text="Marcadores" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0" /></StackPanel>
                </Button>
                <Button Style="{StaticResource Herramienta}">
                    <StackPanel HorizontalAlignment="Center"><FontIcon Glyph="&#xE81C;" FontSize="18" Foreground="{StaticResource Cian}" /><TextBlock Text="Historial" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0" /></StackPanel>
                </Button>
                <Button Style="{StaticResource Herramienta}">
                    <StackPanel HorizontalAlignment="Center"><FontIcon Glyph="&#xE713;" FontSize="18" Foreground="{StaticResource Cian}" /><TextBlock Text="Configuración" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0" /></StackPanel>
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0" Spacing="8">
                <Image Source="Assets/aether-transfer.png" Width="26" Height="26" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="AETHER" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TxtPri}" />
                    <TextBlock Text="TRANSFER" FontSize="10" Foreground="{StaticResource Cian}" Margin="0,-3,0,0" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- CONEXIÓN RÁPIDA -->
        <Grid Grid.Row="2" Background="#0B1A2E" Padding="12,8,12,8" BorderBrush="{StaticResource Linea}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Servidor:" Foreground="{StaticResource TxtSec}" VerticalAlignment="Center" />
                <TextBox Text="192.168.1.10" Width="150" />
                <TextBlock Text="Nombre de usuario:" Foreground="{StaticResource TxtSec}" VerticalAlignment="Center" Margin="6,0,0,0" />
                <TextBox Text="ftpuser" Width="120" />
                <TextBlock Text="Contraseña:" Foreground="{StaticResource TxtSec}" VerticalAlignment="Center" Margin="6,0,0,0" />
                <PasswordBox Password="ftppass" Width="120" />
                <TextBlock Text="Puerto:" Foreground="{StaticResource TxtSec}" VerticalAlignment="Center" Margin="6,0,0,0" />
                <TextBox Text="21" Width="60" />
                <Button Content="Conexión rápida" Background="{StaticResource Acento}" Foreground="White" Margin="6,0,0,0" />
                <Button Content="&#xE70D;" FontFamily="Segoe Fluent Icons" />
            </StackPanel>
        </Grid>

        <!-- CUERPO: rail de navegación + área principal -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Rail de navegación -->
            <StackPanel Grid.Column="0" Width="158" Background="#0C1B30" Padding="8,10,8,10" Spacing="2"
                        BorderBrush="{StaticResource Linea}" BorderThickness="0,0,1,0">
                <Button Style="{StaticResource Nav}" Background="{StaticResource PanelAlt}">
                    <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE80F;" FontSize="16" Foreground="{StaticResource Cian}" /><TextBlock Text="Inicio" /></StackPanel>
                </Button>
                <Button Style="{StaticResource Nav}">
                    <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE8B7;" FontSize="16" /><TextBlock Text="Sitios guardados" /></StackPanel>
                </Button>
                <Button Style="{StaticResource Nav}">
                    <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE898;" FontSize="16" /><TextBlock Text="Transferencias" /></StackPanel>
                </Button>
                <Button Style="{StaticResource Nav}">
                    <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE895;" FontSize="16" /><TextBlock Text="Sincronización" /></StackPanel>
                </Button>
                <Button Style="{StaticResource Nav}">
                    <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE81C;" FontSize="16" /><TextBlock Text="Historial" /></StackPanel>
                </Button>
                <Button Style="{StaticResource Nav}">
                    <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE734;" FontSize="16" /><TextBlock Text="Marcadores" /></StackPanel>
                </Button>
                <Button Style="{StaticResource Nav}">
                    <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE90F;" FontSize="16" /><TextBlock Text="Herramientas" /></StackPanel>
                </Button>
                <Button Style="{StaticResource Nav}">
                    <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE713;" FontSize="16" /><TextBlock Text="Configuración" /></StackPanel>
                </Button>
            </StackPanel>

            <!-- Área principal -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Registro de actividad -->
                <Border Grid.Row="0" Height="104" Margin="10,10,10,6" CornerRadius="6"
                        Background="{StaticResource Panel}" BorderBrush="{StaticResource Linea}" BorderThickness="1">
                    <ScrollViewer Padding="10,6,10,6">
                        <StackPanel Spacing="2">
                            <TextBlock FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TxtSec}"
                                       Text="[11:57:08]  Conectando a 192.168.1.10:21…" />
                            <TextBlock FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TxtSec}"
                                       Text="[11:57:09]  Conexión establecida, esperando el mensaje de bienvenida…" />
                            <TextBlock FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TxtSec}"
                                       Text="[11:57:09]  Servidor: FTP Server (PS4)" />
                            <TextBlock FontFamily="Consolas" FontSize="12" Foreground="#5BD98A"
                                       Text="[11:57:09]  Sesión iniciada correctamente." />
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Explorador doble -->
                <Grid Grid.Row="1" Margin="10,0,10,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Sitio local -->
                    <Border Grid.Column="0" CornerRadius="6" Background="{StaticResource Panel}"
                            BorderBrush="{StaticResource Linea}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Padding="10,8,10,6">
                                <TextBlock Text="Sitio local:" Foreground="{StaticResource TxtSec}" VerticalAlignment="Center" />
                                <TextBox Text="C:\Users\Carlos\" Width="230" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="2" Padding="8,0,8,6">
                                <Button Style="{StaticResource Mini}" Content="&#xE72B;" />
                                <Button Style="{StaticResource Mini}" Content="&#xE72A;" />
                                <Button Style="{StaticResource Mini}" Content="&#xE74A;" />
                                <Button Style="{StaticResource Mini}" Content="&#xE72C;" />
                                <Button Style="{StaticResource Mini}" Content="&#xE8F4;" />
                            </StackPanel>
                            <Grid Grid.Row="2" BorderBrush="{StaticResource Linea}" BorderThickness="0,1,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- Árbol local (estático) -->
                                <ScrollViewer Grid.Column="0" Background="#0C1C32">
                                    <StackPanel Padding="6,8,6,8" Spacing="2">
                                        <TextBlock Text="&#xE977;  Este equipo" Foreground="{StaticResource TxtPri}" FontFamily="Segoe Fluent Icons" FontSize="12" />
                                        <TextBlock Text="   &#xEDA2;  Disco local (C:)" Foreground="{StaticResource TxtSec}" FontFamily="Segoe Fluent Icons" FontSize="12" />
                                        <TextBlock Text="      &#xE8B7;  Usuarios" Foreground="{StaticResource TxtSec}" FontFamily="Segoe Fluent Icons" FontSize="12" />
                                        <Border Background="{StaticResource PanelAlt}" CornerRadius="4" Padding="2,1,2,1">
                                            <TextBlock Text="         &#xE8B7;  Carlos" Foreground="{StaticResource TxtPri}" FontFamily="Segoe Fluent Icons" FontSize="12" />
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                                <!-- Lista local -->
                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Padding="10,5,10,5" Background="#0C1C32">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="86" />
                                            <ColumnDefinition Width="92" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Nombre" Foreground="{StaticResource TxtSec}" FontSize="12" />
                                        <TextBlock Grid.Column="1" Text="Tamaño" Foreground="{StaticResource TxtSec}" FontSize="12" />
                                        <TextBlock Grid.Column="2" Text="Tipo" Foreground="{StaticResource TxtSec}" FontSize="12" />
                                        <TextBlock Grid.Column="3" Text="Modificado" Foreground="{StaticResource TxtSec}" FontSize="12" />
                                    </Grid>
                                    <StackPanel Grid.Row="1" Padding="0,2,0,0">
                                        <Grid Padding="10,4,10,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/><ColumnDefinition Width="86"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="&#xE8B7;  Descargas" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource TxtPri}" FontSize="12.5"/><TextBlock Grid.Column="1" Text="" Foreground="{StaticResource TxtSec}" FontSize="12.5"/><TextBlock Grid.Column="2" Text="Carpeta" Foreground="{StaticResource TxtSec}" FontSize="12.5"/><TextBlock Grid.Column="3" Text="20 nov" Foreground="{StaticResource TxtSec}" FontSize="12.5"/>
                                        </Grid>
                                        <Grid Padding="10,4,10,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/><ColumnDefinition Width="86"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="&#xE8B7;  Documentos" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource TxtPri}" FontSize="12.5"/><TextBlock Grid.Column="1" Text="" Foreground="{StaticResource TxtSec}" FontSize="12.5"/><TextBlock Grid.Column="2" Text="Carpeta" Foreground="{StaticResource TxtSec}" FontSize="12.5"/><TextBlock Grid.Column="3" Text="18 nov" Foreground="{StaticResource TxtSec}" FontSize="12.5"/>
                                        </Grid>
                                        <Grid Padding="10,4,10,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/><ColumnDefinition Width="86"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="&#xE8B7;  Imágenes" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource TxtPri}" FontSize="12.5"/><TextBlock Grid.Column="1" Text="" Foreground="{StaticResource TxtSec}" FontSize="12.5"/><TextBlock Grid.Column="2" Text="Carpeta" Foreground="{StaticResource TxtSec}" FontSize="12.5"/><TextBlock Grid.Column="3" Text="17 nov" Foreground="{StaticResource TxtSec}" FontSize="12.5"/>
                                        </Grid>
                                        <Grid Padding="10,4,10,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/><ColumnDefinition Width="86"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="&#xE8A5;  log.txt" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource TxtPri}" FontSize="12.5"/><TextBlock Grid.Column="1" Text="2.4 KB" Foreground="{StaticResource TxtSec}" FontSize="12.5"/><TextBlock Grid.Column="2" Text="Texto" Foreground="{StaticResource TxtSec}" FontSize="12.5"/><TextBlock Grid.Column="3" Text="18 nov" Foreground="{StaticResource TxtSec}" FontSize="12.5"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                            <TextBlock Grid.Row="3" Text="1 archivo y 6 directorios. Tamaño total: 2.4 KB"
                                       Foreground="{StaticResource TxtSec}" FontSize="11.5" Padding="10,5,10,5" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Width="6" Background="Transparent" />

                    <!-- Sitio remoto -->
                    <Border Grid.Column="2" CornerRadius="6" Background="{StaticResource Panel}"
                            BorderBrush="{StaticResource Linea}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Padding="10,8,10,6">
                                <TextBlock Text="Sitio remoto:" Foreground="{StaticResource TxtSec}" VerticalAlignment="Center" />
                                <TextBox Text="/" Width="230" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="2" Padding="8,0,8,6">
                                <Button Style="{StaticResource Mini}" Content="&#xE72B;" />
                                <Button Style="{StaticResource Mini}" Content="&#xE72A;" />
                                <Button Style="{StaticResource Mini}" Content="&#xE74A;" />
                                <Button Style="{StaticResource Mini}" Content="&#xE72C;" />
                                <Button Style="{StaticResource Mini}" Content="&#xE8F4;" />
                            </StackPanel>
                            <Grid Grid.Row="2" BorderBrush="{StaticResource Linea}" BorderThickness="0,1,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ScrollViewer Grid.Column="0" Background="#0C1C32">
                                    <StackPanel Padding="6,8,6,8" Spacing="2">
                                        <TextBlock Text="&#xE8B7;  /" Foreground="{StaticResource TxtPri}" FontFamily="Segoe Fluent Icons" FontSize="12" />
                                        <TextBlock Text="   &#xE8B7;  app" Foreground="{StaticResource TxtSec}" FontFamily="Segoe Fluent Icons" FontSize="12" />
                                        <TextBlock Text="   &#xE8B7;  data" Foreground="{StaticResource TxtSec}" FontFamily="Segoe Fluent Icons" FontSize="12" />
                                        <TextBlock Text="   &#xE8B7;  dev" Foreground="{StaticResource TxtSec}" FontFamily="Segoe Fluent Icons" FontSize="12" />
                                        <TextBlock Text="   &#xE8B7;  system" Foreground="{StaticResource TxtSec}" FontFamily="Segoe Fluent Icons" FontSize="12" />
                                        <TextBlock Text="   &#xE8B7;  user" Foreground="{StaticResource TxtSec}" FontFamily="Segoe Fluent Icons" FontSize="12" />
                                    </StackPanel>
                                </ScrollViewer>
                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Padding="10,5,10,5" Background="#0C1C32">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="64" /><ColumnDefinition Width="86" /><ColumnDefinition Width="92" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Nombre" Foreground="{StaticResource TxtSec}" FontSize="12" />
                                        <TextBlock Grid.Column="1" Text="Tamaño" Foreground="{StaticResource TxtSec}" FontSize="12" />
                                        <TextBlock Grid.Column="2" Text="Tipo" Foreground="{StaticResource TxtSec}" FontSize="12" />
                                        <TextBlock Grid.Column="3" Text="Modificado" Foreground="{StaticResource TxtSec}" FontSize="12" />
                                    </Grid>
                                    <StackPanel Grid.Row="1" Padding="0,2,0,0">
                                        <Grid Padding="10,4,10,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/><ColumnDefinition Width="86"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="&#xE8B7;  app" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource TxtPri}" FontSize="12.5"/><TextBlock Grid.Column="1" Text="" Foreground="{StaticResource TxtSec}" FontSize="12.5"/><TextBlock Grid.Column="2" Text="Carpeta" Foreground="{StaticResource TxtSec}" FontSize="12.5"/><TextBlock Grid.Column="3" Text="10 nov" Foreground="{StaticResource TxtSec}" FontSize="12.5"/>
                                        </Grid>
                                        <Grid Padding="10,4,10,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/><ColumnDefinition Width="86"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="&#xE8B7;  data" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource TxtPri}" FontSize="12.5"/><TextBlock Grid.Column="1" Text="" Foreground="{StaticResource TxtSec}" FontSize="12.5"/><TextBlock Grid.Column="2" Text="Carpeta" Foreground="{StaticResource TxtSec}" FontSize="12.5"/><TextBlock Grid.Column="3" Text="10 nov" Foreground="{StaticResource TxtSec}" FontSize="12.5"/>
                                        </Grid>
                                        <Grid Padding="10,4,10,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/><ColumnDefinition Width="86"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="&#xE8B7;  user" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource TxtPri}" FontSize="12.5"/><TextBlock Grid.Column="1" Text="" Foreground="{StaticResource TxtSec}" FontSize="12.5"/><TextBlock Grid.Column="2" Text="Carpeta" Foreground="{StaticResource TxtSec}" FontSize="12.5"/><TextBlock Grid.Column="3" Text="10 nov" Foreground="{StaticResource TxtSec}" FontSize="12.5"/>
                                        </Grid>
                                        <Grid Padding="10,4,10,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/><ColumnDefinition Width="86"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="&#xE8B7;  update" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource TxtPri}" FontSize="12.5"/><TextBlock Grid.Column="1" Text="" Foreground="{StaticResource TxtSec}" FontSize="12.5"/><TextBlock Grid.Column="2" Text="Carpeta" Foreground="{StaticResource TxtSec}" FontSize="12.5"/><TextBlock Grid.Column="3" Text="10 nov" Foreground="{StaticResource TxtSec}" FontSize="12.5"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                            <TextBlock Grid.Row="3" Text="8 directorios" Foreground="{StaticResource TxtSec}" FontSize="11.5" Padding="10,5,10,5" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- Cola de transferencias -->
                <Border Grid.Row="2" Height="176" Margin="10,0,10,8" CornerRadius="6"
                        Background="{StaticResource Panel}" BorderBrush="{StaticResource Linea}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="18" Padding="12,8,12,6">
                            <TextBlock Text="Archivos en cola (1)" Foreground="{StaticResource Cian}" FontWeight="SemiBold" />
                            <TextBlock Text="Transferencias fallidas" Foreground="{StaticResource TxtSec}" />
                            <TextBlock Text="Transferencias satisfactorias (3)" Foreground="{StaticResource TxtSec}" />
                        </StackPanel>
                        <Grid Grid.Row="1" Padding="12,4,12,4" Background="#0C1C32" BorderBrush="{StaticResource Linea}" BorderThickness="0,1,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="220" /><ColumnDefinition Width="70" /><ColumnDefinition Width="120" /><ColumnDefinition Width="90" /><ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Servidor / Archivo local" Foreground="{StaticResource TxtSec}" FontSize="12" />
                            <TextBlock Grid.Column="1" Text="Dirección remota" Foreground="{StaticResource TxtSec}" FontSize="12" />
                            <TextBlock Grid.Column="2" Text="Tamaño" Foreground="{StaticResource TxtSec}" FontSize="12" />
                            <TextBlock Grid.Column="3" Text="Progreso" Foreground="{StaticResource TxtSec}" FontSize="12" />
                            <TextBlock Grid.Column="4" Text="Velocidad" Foreground="{StaticResource TxtSec}" FontSize="12" />
                            <TextBlock Grid.Column="5" Text="Estado" Foreground="{StaticResource TxtSec}" FontSize="12" />
                        </Grid>
                        <Grid Grid.Row="2" Padding="12,8,12,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="220" /><ColumnDefinition Width="70" /><ColumnDefinition Width="120" /><ColumnDefinition Width="90" /><ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Top">
                                <TextBlock Text="ftpuser@192.168.1.10" Foreground="{StaticResource TxtPri}" FontSize="12.5" />
                                <TextBlock Text="C:\Users\Carlos\Descargas\Juegos\God_of_War_2.iso" Foreground="{StaticResource TxtSec}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="/data/Games/God_of_War_2.iso" Foreground="{StaticResource TxtSec}" FontSize="12" VerticalAlignment="Top" TextTrimming="CharacterEllipsis" />
