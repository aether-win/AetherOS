<Window x:Class="AetherTransfer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AETHER TRANSFER" Height="820" Width="1280"
        MinHeight="560" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/aether-transfer.ico"
        Background="#0A1524"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI" FontSize="13">

    <Grid x:Name="Raiz">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== BARRA DE HERRAMIENTAS ===== -->
        <Border Grid.Row="0" Background="#0C1B30" BorderBrush="#1E3A5C" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" Margin="8,6">
                    <Button Style="{StaticResource BtnPlano}" Click="AdminSitios_Click" Margin="0,0,2,0">
                        <StackPanel>
                            <TextBlock Text="&#xE825;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#22D3EE" HorizontalAlignment="Center" />
                            <TextBlock Text="Sitios" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BtnPlano}" Click="Conectar_Click" Margin="0,0,2,0">
                        <StackPanel>
                            <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#22D3EE" HorizontalAlignment="Center" />
                            <TextBlock Text="Conectar" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BtnPlano}" Click="Desconectar_Click" Margin="0,0,2,0">
                        <StackPanel>
                            <TextBlock Text="&#xE8CB;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#22D3EE" HorizontalAlignment="Center" />
                            <TextBlock Text="Desconectar" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Border Width="1" Background="#1E3A5C" Margin="6,4" />
                    <Button Style="{StaticResource BtnPlano}" Click="Sincronizar_Click" Margin="0,0,2,0">
                        <StackPanel>
                            <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#22D3EE" HorizontalAlignment="Center" />
                            <TextBlock Text="Sincronizar" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BtnPlano}" Click="Config_Click">
                        <StackPanel>
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#22D3EE" HorizontalAlignment="Center" />
                            <TextBlock Text="Configuración" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Image Source="Assets/aether-transfer.png" Width="26" Height="26" Margin="0,0,8,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="AETHER" FontWeight="Bold" FontSize="15" />
                        <TextBlock Text="TRANSFER" FontSize="10" Foreground="#22D3EE" Margin="0,-3,0,0" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== CONEXIÓN RÁPIDA ===== -->
        <Border Grid.Row="1" Background="#0B1A2E" BorderBrush="#1E3A5C" BorderThickness="0,0,0,1" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Servidor:" Foreground="#9DB2CC" Margin="0,0,6,0" />
                <TextBox x:Name="TxtHost" Text="192.168.1.10" Width="150" Margin="0,0,10,0" />
                <TextBlock Text="Usuario:" Foreground="#9DB2CC" Margin="0,0,6,0" />
                <TextBox x:Name="TxtUsuario" Text="anonymous" Width="120" Margin="0,0,10,0" />
                <TextBlock Text="Contraseña:" Foreground="#9DB2CC" Margin="0,0,6,0" />
                <PasswordBox x:Name="TxtPass" Width="120" Margin="0,0,10,0" />
                <TextBlock Text="Puerto:" Foreground="#9DB2CC" Margin="0,0,6,0" />
                <TextBox x:Name="TxtPuerto" Text="21" Width="56" Margin="0,0,10,0" />
                <Button x:Name="BtnConectar" Content="Conexión rápida" Click="Conectar_Click" />
            </StackPanel>
        </Border>

        <!-- ===== CUERPO ===== -->
        <Grid Grid.Row="2" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Registro -->
            <Border Grid.Row="0" Height="84" Margin="0,0,0,8" CornerRadius="6"
                    Background="#0F2036" BorderBrush="#1E3A5C" BorderThickness="1">
                <ListBox x:Name="LogLista" Margin="6,4" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" Foreground="#9DB2CC" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Explorador doble -->
            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="54" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sitio local -->
                <Border Grid.Column="0" CornerRadius="6" Background="#0F2036" BorderBrush="#1E3A5C" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,8,10,6">
                            <TextBlock Text="Sitio local:" Foreground="#9DB2CC" Margin="0,0,8,0" />
                            <TextBox x:Name="TxtLocalRuta" Width="230" IsReadOnly="True" Margin="0,0,6,0" />
                            <Button Style="{StaticResource BtnPlano}" Click="LocalSubir_Click" ToolTip="Subir un nivel" Padding="7,4">
                                <TextBlock Text="&#xE70E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#C7D6EC" />
                            </Button>
                            <Button Style="{StaticResource BtnPlano}" Click="LocalActualizar_Click" ToolTip="Actualizar" Padding="7,4">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#C7D6EC" />
                            </Button>
                        </StackPanel>
                        <Border Grid.Row="1" Height="1" Background="#1E3A5C" />
                        <ListView x:Name="LocalLista" Grid.Row="2" Margin="2" SelectionMode="Extended"
                                  MouseDoubleClick="LocalLista_DoubleTapped"
                                  PreviewMouseRightButtonDown="Lista_RightTapped">
                            <ListView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Subir al servidor" Click="Subir_Click" />
                                    <MenuItem Header="Nueva carpeta" Click="LocalNuevaCarpeta_Click" />
                                    <MenuItem Header="Renombrar" Click="LocalRenombrar_Click" />
                                    <MenuItem Header="Eliminar" Click="LocalEliminar_Click" />
                                    <Separator />
                                    <MenuItem Header="Actualizar" Click="LocalActualizar_Click" />
                                </ContextMenu>
                            </ListView.ContextMenu>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="112" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#E0C060" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Nombre}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding TamanoTexto}" FontSize="12" Foreground="#9DB2CC" />
                                        <TextBlock Grid.Column="2" Text="{Binding Tipo}" FontSize="12" Foreground="#9DB2CC" />
                                        <TextBlock Grid.Column="3" Text="{Binding FechaTexto}" FontSize="12" Foreground="#9DB2CC" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="LocalInfo" Grid.Row="3" Text="" Foreground="#9DB2CC" FontSize="11.5" Margin="10,5" />
                    </Grid>
                </Border>

                <!-- Botones de transferencia -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Button Click="Subir_Click" Width="36" Height="36" Background="#1E6BFF" ToolTip="Subir al servidor" Margin="0,0,0,10">
                        <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" />
                    </Button>
                    <Button Click="Descargar_Click" Width="36" Height="36" Background="#122844" ToolTip="Descargar al equipo">
                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#22D3EE" />
                    </Button>
                </StackPanel>

                <!-- Sitio remoto -->
                <Border Grid.Column="2" CornerRadius="6" Background="#0F2036" BorderBrush="#1E3A5C" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,8,10,6">
                            <TextBlock Text="Sitio remoto:" Foreground="#9DB2CC" Margin="0,0,8,0" />
                            <TextBox x:Name="TxtRemotoRuta" Width="210" IsReadOnly="True" Margin="0,0,6,0" />
                            <Button Style="{StaticResource BtnPlano}" Click="RemotoSubir_Click" ToolTip="Subir un nivel" Padding="7,4">
                                <TextBlock Text="&#xE70E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#C7D6EC" />
                            </Button>
                            <Button Style="{StaticResource BtnPlano}" Click="RemotoActualizar_Click" ToolTip="Actualizar" Padding="7,4">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#C7D6EC" />
                            </Button>
                        </StackPanel>
                        <Border Grid.Row="1" Height="1" Background="#1E3A5C" />
                        <ListView x:Name="RemotoLista" Grid.Row="2" Margin="2" SelectionMode="Extended"
                                  MouseDoubleClick="RemotoLista_DoubleTapped"
                                  PreviewMouseRightButtonDown="Lista_RightTapped">
                            <ListView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Descargar al equipo" Click="Descargar_Click" />
                                    <MenuItem Header="Nueva carpeta" Click="RemotoNuevaCarpeta_Click" />
                                    <MenuItem Header="Renombrar" Click="RemotoRenombrar_Click" />
                                    <MenuItem Header="Eliminar" Click="RemotoEliminar_Click" />
                                    <Separator />
                                    <MenuItem Header="Actualizar" Click="RemotoActualizar_Click" />
                                </ContextMenu>
                            </ListView.ContextMenu>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="112" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#E0C060" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Nombre}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding TamanoTexto}" FontSize="12" Foreground="#9DB2CC" />
                                        <TextBlock Grid.Column="2" Text="{Binding Tipo}" FontSize="12" Foreground="#9DB2CC" />
                                        <TextBlock Grid.Column="3" Text="{Binding FechaTexto}" FontSize="12" Foreground="#9DB2CC" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="RemotoInfo" Grid.Row="3" Text="No conectado" Foreground="#9DB2CC" FontSize="11.5" Margin="10,5" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Cola de transferencias -->
            <Border Grid.Row="2" Height="150" CornerRadius="6"
                    Background="#0F2036" BorderBrush="#1E3A5C" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12,8,12,6">
                        <TextBlock x:Name="TabCola" Text="Archivos en cola (0)" Foreground="#22D3EE" FontWeight="SemiBold" Margin="0,0,18,0" />
                        <TextBlock x:Name="TabFallidas" Text="Transferencias fallidas (0)" Foreground="#9DB2CC" Margin="0,0,18,0" />
                        <TextBlock x:Name="TabHechas" Text="Transferencias satisfactorias (0)" Foreground="#9DB2CC" />
                    </StackPanel>
                    <Border Grid.Row="1" Height="1" Background="#1E3A5C" />
                    <Grid Grid.Row="2">
                        <ListView x:Name="ColaLista" Margin="2">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="30" Margin="10,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="150" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock Text="{Binding DireccionIcono}" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#22D3EE" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Nombre}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding RutaRemota}" FontSize="11.5" Foreground="#9DB2CC" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding TamanoTexto}" FontSize="11.5" Foreground="#9DB2CC" />
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                            <ProgressBar Value="{Binding Progreso}" Maximum="100" Width="90" Height="6" HorizontalAlignment="Left" Foreground="#1E6BFF" Background="#0A1726" BorderThickness="0" />
                                            <TextBlock Text="{Binding ProgresoTexto}" FontSize="10.5" Foreground="#9DB2CC" Margin="0,1,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="4" Text="{Binding VelocidadTexto}" FontSize="11.5" Foreground="#9DB2CC" />
                                        <StackPanel Grid.Column="5" Orientation="Horizontal">
                                            <TextBlock Text="{Binding EstadoTexto}" FontSize="11.5" Foreground="#E6EEF8" Width="78" TextTrimming="CharacterEllipsis" />
                                            <Button Style="{StaticResource BtnPlano}" Click="Pausar_Click" ToolTip="Pausar/Reanudar" Padding="4">
                                                <TextBlock Text="&#xE769;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#9DB2CC" />
                                            </Button>
                                            <Button Style="{StaticResource BtnPlano}" Click="Cancelar_Click" ToolTip="Cancelar/Quitar" Padding="4">
                                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#9DB2CC" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="ColaVacia" Text="No hay transferencias en cola."
                                   Foreground="#9DB2CC" FontSize="12" Margin="12,10" VerticalAlignment="Top" HorizontalAlignment="Left" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== BARRA DE ESTADO ===== -->
        <Border Grid.Row="3" Background="#0C1B30" BorderBrush="#1E3A5C" BorderThickness="0,1,0,0" Padding="12,5">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="EstadoPunto" Width="8" Height="8" Fill="#6B7B90" Margin="0,0,8,0" />
                <TextBlock x:Name="TxtEstado" Text="No conectado" Foreground="#9DB2CC" FontSize="12" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
