<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="AetherTransfer.Views.DialogoSync"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:AetherTransfer.Views"
    Title="Sincronización"
    PrimaryButtonText="Sincronizar"
    CloseButtonText="Cerrar"
    DefaultButton="Primary"
    RequestedTheme="Dark">

    <Grid Width="620" Height="420" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <TextBlock Text="Dirección:" VerticalAlignment="Center" Foreground="#9DB2CC" />
            <ComboBox x:Name="CmbDireccion" SelectedIndex="0" SelectionChanged="Direccion_Changed" MinWidth="240">
                <ComboBoxItem Content="Subir (local → remoto)" />
                <ComboBoxItem Content="Descargar (remoto → local)" />
            </ComboBox>
        </StackPanel>

        <TextBlock Grid.Row="1" Foreground="#9DB2CC" FontSize="12"
                   Text="Vista previa. No se elimina nada automáticamente; solo se copian los archivos marcados." />

        <Border Grid.Row="2" BorderBrush="#1E3A5C" BorderThickness="1" CornerRadius="6" Background="#0F2036">
            <ListView x:Name="ListaSync" SelectionMode="None" Padding="2">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="views:FilaSync">
                        <Grid Height="28" Padding="8,0,8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="180" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind Nombre}" VerticalAlignment="Center" FontSize="12.5" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Estado}" VerticalAlignment="Center" FontSize="12" Foreground="#22D3EE" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <TextBlock Grid.Row="3" x:Name="TxtResumen" Foreground="#9DB2CC" FontSize="12" Text="" />
    </Grid>
</ContentDialog>
