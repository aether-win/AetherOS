<Window x:Class="AetherTransfer.Views.DialogoSync"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sincronizar carpetas" Height="460" Width="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="ToolWindow" Background="#0A1524"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Dirección:" Foreground="#9DB2CC" Margin="0,0,8,0" />
            <ComboBox x:Name="CmbDireccion" Width="260" SelectedIndex="0" SelectionChanged="Direccion_Changed">
                <ComboBoxItem Content="Subir: equipo → servidor" />
                <ComboBoxItem Content="Descargar: servidor → equipo" />
            </ComboBox>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="Comparación de archivos" Foreground="#22D3EE" FontWeight="SemiBold" Margin="0,0,0,6" />

        <Border Grid.Row="2" CornerRadius="6" Background="#0F2036" BorderBrush="#1E3A5C" BorderThickness="1">
            <ListView x:Name="ListaSync" Margin="4">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="26">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="230" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Nombre}" Foreground="#E6EEF8" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding Estado}" Foreground="#9DB2CC" FontSize="12" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <TextBlock x:Name="TxtResumen" Grid.Row="3" Text="" Foreground="#22D3EE" FontSize="12.5" Margin="0,10,0,0" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Sincronizar" Click="Sincronizar_Click" Background="#1E6BFF" Width="130" Margin="0,0,8,0" />
            <Button Content="Cancelar" Click="Cancelar_Click" Background="#12283F" Width="100" />
        </StackPanel>
    </Grid>
</Window>
