<Window x:Class="AetherTransfer.Views.DialogoSitios"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Administrador de sitios" Height="440" Width="720"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="ToolWindow" Background="#0A1524"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Lista de sitios -->
        <Border Grid.Column="0" Grid.Row="0" CornerRadius="6" Background="#0F2036" BorderBrush="#1E3A5C" BorderThickness="1" Margin="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Sitios guardados" Foreground="#22D3EE" FontWeight="SemiBold" Margin="10,8" />
                <ListBox x:Name="SitiosLista" Grid.Row="1" Margin="4,0,4,6" SelectionChanged="Sitio_Changed"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,3">
                                <TextBlock Text="{Binding Nombre}" Foreground="#E6EEF8" FontSize="13" />
                                <TextBlock Text="{Binding Host}" Foreground="#9DB2CC" FontSize="11" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Formulario -->
        <Border Grid.Column="1" Grid.Row="0" CornerRadius="6" Background="#0F2036" BorderBrush="#1E3A5C" BorderThickness="1">
            <StackPanel Margin="16,12">
                <TextBlock Text="Datos del sitio" Foreground="#22D3EE" FontWeight="SemiBold" Margin="0,0,0,10" />

                <TextBlock Text="Nombre" Foreground="#9DB2CC" Margin="0,0,0,2" />
                <TextBox x:Name="FNombre" Margin="0,0,0,8" />

                <TextBlock Text="Servidor (host)" Foreground="#9DB2CC" Margin="0,0,0,2" />
                <TextBox x:Name="FHost" Margin="0,0,0,8" />

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Protocolo" Foreground="#9DB2CC" Margin="0,0,0,2" />
                        <ComboBox x:Name="FProtocolo" SelectedIndex="0" SelectionChanged="Protocolo_Changed">
                            <ComboBoxItem Content="FTP" />
                            <ComboBoxItem Content="FTP sobre TLS (explícito)" />
                            <ComboBoxItem Content="FTP sobre TLS (implícito)" />
                            <ComboBoxItem Content="SFTP (SSH)" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Puerto" Foreground="#9DB2CC" Margin="0,0,0,2" />
                        <TextBox x:Name="FPuerto" Text="21" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Usuario" Foreground="#9DB2CC" Margin="0,0,0,2" />
                        <TextBox x:Name="FUsuario" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Contraseña" Foreground="#9DB2CC" Margin="0,0,0,2" />
                        <PasswordBox x:Name="FPassword" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Directorio inicial" Foreground="#9DB2CC" Margin="0,0,0,2" />
                <TextBox x:Name="FDirInicial" Text="/" Margin="0,0,0,8" />

                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <Button Content="Nuevo" Click="Nuevo_Click" Background="#12283F" Margin="0,0,8,0" />
                    <Button Content="Guardar" Click="Guardar_Click" Background="#1E6BFF" Margin="0,0,8,0" />
                    <Button Content="Eliminar" Click="Eliminar_Click" Background="#5A1E2A" />
                </StackPanel>

                <TextBlock x:Name="FAviso" Text="" Foreground="#22D3EE" FontSize="11.5" Margin="0,10,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Botones inferiores -->
        <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Conectar" Click="Conectar_Click" Background="#1E6BFF" Width="130" Margin="0,0,8,0" />
            <Button Content="Cerrar" Click="Cerrar_Click" Background="#12283F" Width="100" />
        </StackPanel>
    </Grid>
</Window>
