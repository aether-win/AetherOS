<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="AetherTransfer.Views.DialogoSitios"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conn="using:AetherTransfer.Connections"
    Title="Administrador de sitios"
    PrimaryButtonText="Conectar"
    CloseButtonText="Cerrar"
    DefaultButton="Primary"
    RequestedTheme="Dark">

    <Grid Width="640" Height="400" ColumnSpacing="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Lista de sitios -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" BorderBrush="#1E3A5C" BorderThickness="1" CornerRadius="6" Background="#0F2036">
                <ListView x:Name="SitiosLista" SelectionChanged="Sitio_Changed" Padding="2">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="conn:SitioGuardado">
                            <StackPanel Padding="4,6,4,6">
                                <TextBlock Text="{x:Bind Nombre}" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind Host}" FontSize="12" Foreground="#9DB2CC" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                <Button Content="Nuevo" Click="Nuevo_Click" />
                <Button Content="Eliminar" Click="Eliminar_Click" />
            </StackPanel>
        </Grid>

        <!-- Formulario -->
        <ScrollViewer Grid.Column="1">
            <StackPanel Spacing="10">
                <TextBox x:Name="FNombre" Header="Nombre" PlaceholderText="Mi PS4" />
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FHost" Grid.Column="0" Header="Servidor" PlaceholderText="192.168.1.10" />
                    <TextBox x:Name="FPuerto" Grid.Column="1" Header="Puerto" Text="21" />
                </Grid>
                <ComboBox x:Name="FProtocolo" Header="Protocolo" HorizontalAlignment="Stretch" SelectedIndex="0"
                          SelectionChanged="Protocolo_Changed">
                    <ComboBoxItem Content="FTP" />
                    <ComboBoxItem Content="FTPS explícito" />
                    <ComboBoxItem Content="FTPS implícito" />
                    <ComboBoxItem Content="SFTP (SSH)" />
                </ComboBox>
                <TextBox x:Name="FUsuario" Header="Usuario" PlaceholderText="anonymous" />
                <PasswordBox x:Name="FPassword" Header="Contraseña" />
                <TextBox x:Name="FDirInicial" Header="Directorio inicial" Text="/" />
                <Button Content="Guardar sitio" Click="Guardar_Click" HorizontalAlignment="Left" />
                <TextBlock x:Name="FAviso" Text="" Foreground="#5BD98A" FontSize="12" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ContentDialog>
